{
	"name": "reviewbird",
	"version": "1.3.5",
	"packageManager": "pnpm@11.0.1",
	"description": "WordPress plugin for reviewbird integration",
	"files": [
		"reviewbird-plugin.php",
		"readme.txt",
		"composer.json",
		"package.json",
		"assets/build/**",
		"assets/css/**",
		"languages/**",
		"licenses/**",
		"templates/**",
		"src/**",
		"vendor/autoload.php",
		"vendor/pressmodo/wp-admin-notices/src/**",
		"vendor/composer/*.php",
		"vendor/composer/installed.json",
		"vendor/composer/LICENSE",
		"!**/.gitkeep",
		"!**/.DS_Store"
	],
	"scripts": {
		"build": "wp-scripts build",
		"dev": "wp-scripts start",
		"plugin-zip": "pnpm run build && composer install --no-dev && wp-scripts plugin-zip && composer install",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"lint:php": "composer lint",
		"format:php": "composer lint-fix",
		"test": "wp-scripts test-unit-js",
		"make:pot": "wp i18n make-pot . languages/reviewbird.pot --exclude=\".*,.*/**,node_modules/**,vendor/**,tests/**,assets/build/**\" --domain=\"reviewbird\" --slug=\"reviewbird\"",
		"make:json": "rm -f languages/*.json && wp i18n make-json languages '--use-map=[\"assets/build/map-admin.json\"]' --no-purge"
	},
	"keywords": [
		"wordpress",
		"plugin",
		"reviews",
		"woocommerce"
	],
	"author": "Reviewbird",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@svgr/webpack": "^8.1.0",
		"@wordpress/scripts": "^30.26.0",
		"url-loader": "^4.1.1",
		"webpack-bundle-output": "^1.1.0"
	},
	"dependencies": {
		"@wordpress/element": "^5.0.0",
		"@wordpress/i18n": "^4.0.0"
	}
}
