#: assets/src/js/components/SettingsApp.jsx:114
msgid "Reviewbird Widget"
msgstr "Widget Reviewbird"

#: assets/src/js/components/SettingsApp.jsx:115
msgid "Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews."
msgstr "Exiba o widget de avaliações Reviewbird nas páginas dos produtos. O widget mostra avaliações de clientes e permite que os clientes submetam novas avaliações."

#: assets/src/js/components/SettingsApp.jsx:121
msgid "Widget is enabled on all WooCommerce product pages."
msgstr "O widget está ativado em todas as páginas de produtos WooCommerce."

#: assets/src/js/components/SettingsApp.jsx:130
msgid "Forcefully enable reviews on all products"
msgstr "Ativar avaliações em todos os produtos de forma forçada"

#: assets/src/js/components/SettingsApp.jsx:136
msgid "Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox."
msgstr "Deixe esta opção desativada se preferir controlar as avaliações por produto usando a caixa de seleção \"Ativar avaliações\"."

#: assets/src/js/components/SettingsApp.jsx:172
msgid "SEO Schema Markup"
msgstr "Marcações de Esquema SEO"

#: assets/src/js/components/SettingsApp.jsx:173
msgid "Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results."
msgstr "Ativar dados estruturados compatíveis com o Google (esquema JSON-LD) nas páginas dos produtos para snippets enriquecidos nos resultados de pesquisa."

#: assets/src/js/components/SettingsApp.jsx:179
msgid "Schema markup is active on all WooCommerce product pages."
msgstr "A marcação de esquema está ativa em todas as páginas de produtos WooCommerce."

#: assets/src/js/components/SettingsApp.jsx:184
msgid "What is Schema Markup?"
msgstr "O que é Marcações de Esquema?"

#: assets/src/js/components/SettingsApp.jsx:186
msgid "Displays star ratings in Google search results"
msgstr "Exibe classificações por estrelas nos resultados de pesquisa do Google"

#: assets/src/js/components/SettingsApp.jsx:190
msgid "Shows review counts and product information"
msgstr "Mostra contagens de avaliações e informações do produto"

#: assets/src/js/components/SettingsApp.jsx:194
msgid "Review schema is cached for 4 hours for optimal performance"
msgstr "O esquema de avaliações é armazenado em cache por 4 horas para desempenho ideal"

#: assets/src/js/components/SettingsApp.jsx:203
msgid "Test with Google Rich Results"
msgstr "Testar com Resultados Ricos do Google"

#: assets/src/js/components/SettingsApp.jsx:210
msgid "Validate Schema"
msgstr "Validar Esquema"

