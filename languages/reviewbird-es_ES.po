msgid "Connected Store Settings"
msgstr "Configuración de la tienda conectada"

#: assets/src/js/components/SettingsApp.jsx:94
msgid "Manage your Reviewbird integration with WooCommerce."
msgstr "Gestiona tu integración de Reviewbird con WooCommerce."

#: assets/src/js/components/SettingsApp.jsx:111
msgid "Reviewbird Widget"
msgstr "Widget de Reviewbird"

#: assets/src/js/components/SettingsApp.jsx:112
msgid ""
"Display Reviewbird review widget on product pages. The widget shows customer "
"reviews and allows customers to submit new reviews."
msgstr ""
"Muestra el widget de reseñas de Reviewbird en las páginas de productos. El "
"widget muestra reseñas de clientes y permite que los clientes envíen nuevas "
"reseñas."

#: assets/src/js/components/SettingsApp.jsx:118
msgid "Widget is enabled on all WooCommerce product pages."
msgstr ""
"El widget está habilitado en todas las páginas de productos de WooCommerce."

#: assets/src/js/components/SettingsApp.jsx:127
msgid "Forcefully enable reviews on all products"
msgstr "Forzar la habilitación de reseñas en todos los productos"

#: assets/src/js/components/SettingsApp.jsx:133
msgid ""
"Leave this off if you prefer to control reviews per product using the "
"\"Enable reviews\" checkbox."
msgstr ""
"Deje esto desactivado si prefiere controlar las reseñas por producto usando "
"la casilla \"Habilitar reseñas\"."

#: assets/src/js/components/SettingsApp.jsx:169
msgid "SEO Schema Markup"
msgstr "Marcado de esquema SEO"

#: assets/src/js/components/SettingsApp.jsx:170
msgid ""
"Enable Google-compliant structured data (JSON-LD schema) on product pages "
"for rich snippets in search results."
msgstr ""
"Habilitar datos estructurados compatibles con Google (esquema JSON-LD) en "
"las páginas de productos para fragmentos enriquecidos en los resultados de "
"búsqueda."

#: assets/src/js/components/SettingsApp.jsx:176
msgid "Schema markup is active on all WooCommerce product pages."
msgstr ""
"El marcado de esquema está activo en todas las páginas de productos de "
"WooCommerce."

#: assets/src/js/components/SettingsApp.jsx:181
msgid "What is Schema Markup?"
msgstr "¿Qué es el marcado de esquema?"

#: assets/src/js/components/SettingsApp.jsx:183
msgid "Displays star ratings in Google search results"
msgstr ""
"Muestra valoraciones con estrellas en los resultados de búsqueda de Google"

#: assets/src/js/components/SettingsApp.jsx:187
msgid "Shows review counts and product information"
msgstr "Muestra el recuento de reseñas e información del producto"

#: assets/src/js/components/SettingsApp.jsx:191
msgid "Review schema is cached for 4 hours for optimal performance"
msgstr ""
"El esquema de reseñas se almacena en caché durante 4 horas para un "
"rendimiento óptimo"

#: assets/src/js/components/SettingsApp.jsx:200
msgid "Test with Google Rich Results"
msgstr "Probar con Google Rich Results"

#: assets/src/js/components/SettingsApp.jsx:207
msgid "Validate Schema"
msgstr "Validar esquema"

