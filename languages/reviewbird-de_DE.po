#. Plugin URI of the plugin
#: reviewbird-plugin.php
msgid "https://reviewbird.com"
msgstr "https://reviewbird.com"

#. Description of the plugin
#: reviewbird-plugin.php
msgid ""
"Automated review collection for WooCommerce that blocks spam, catches "
"complaints, and showcases your best feedback."
msgstr ""
"Automatisierte Bewertungs­erfassung für WooCommerce, die Spam blockiert, "
"Beschwerden erkennt und Ihr bestes Feedback präsentiert."

