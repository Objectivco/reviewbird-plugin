msgid "Review count must be a whole number of 0 or more"
msgstr "Arvostelujen määrän on oltava kokonaisluku, joka on 0 tai suurempi"

#: src/api.php:244
msgid "Average stars must be between 0 and 5, and 0 when there are no reviews"
msgstr "Keskiarvotähtien on oltava välillä 0–5, ja 0, kun arvosteluja ei ole"

#: src/api.php:252
msgid "Rating counts must contain whole numbers of 0 or more for stars 1 to 5 and must not exceed the review count."
msgstr "Arvostelujen lukumäärien on oltava kokonaislukuja, jotka ovat 0 tai enemmän tähdille 1–5, eikä niiden saa ylittää arvostelujen kokonaismäärää."

#: src/api.php:296
msgid "Customer email is required"
msgstr "Asiakkaan sähköposti vaaditaan"

#: src/api.php:299
msgid "Invalid email address"
msgstr "Virheellinen sähköpostiosoite"

#: src/api.php:432
msgid "Coupon code is required"
msgstr "Kupongin koodi vaaditaan"

#: src/api.php:436
msgid "Use a valid date or ISO 8601 date and time for coupon expiry."
msgstr "Käytä voimassa olevaa päivämäärää tai ISO 8601 -päivämäärä- ja aikamuotoa kupongin vanhentumiseen."

#: src/api.php:439
msgid "This coupon code already exists."
msgstr "Tämä kuponkikoodi on jo olemassa."

