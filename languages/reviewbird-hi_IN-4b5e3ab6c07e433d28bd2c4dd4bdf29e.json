{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi_IN","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["Reviewbird \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Connected to Reviewbird":["Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u0906\u092a\u0915\u093e WooCommerce \u0938\u094d\u091f\u094b\u0930 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 \u0939\u0948\u0964 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e \u0938\u0939\u0940 \u0922\u0902\u0917 \u0938\u0947 \u0938\u093f\u0902\u0915 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964"],"View Dashboard":["\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u0947\u0902"],"WooCommerce Not Connected":["WooCommerce \u091c\u0941\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0939\u0948"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u0905\u092d\u0940 \u0924\u0915 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0938\u094d\u091f\u094b\u0930 \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0909\u0924\u094d\u092a\u093e\u0926 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u0938\u093f\u0902\u0915 \u0939\u094b \u0938\u0915\u0947\u0902\u0964"],"Connect WooCommerce":["WooCommerce \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902"],"Initial Sync in Progress":["\u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0938\u093f\u0902\u0915 \u092a\u094d\u0930\u0917\u0924\u093f \u092a\u0930 \u0939\u0948"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u0906\u092a\u0915\u0947 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902 \u0915\u094b \u0938\u093f\u0902\u0915 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u0915\u0948\u091f\u0932\u0949\u0917 \u0915\u0947 \u0906\u0915\u093e\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0907\u0938\u092e\u0947\u0902 \u0915\u0941\u091b \u092e\u093f\u0928\u091f \u0932\u0917 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u093f\u0902\u0915 \u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u092a\u0930 \u0935\u093f\u091c\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b\u0917\u093e\u0964"],"View Sync Progress":["\u0938\u093f\u0902\u0915 \u092a\u094d\u0930\u0917\u0924\u093f \u0926\u0947\u0916\u0947\u0902"],"Subscription Required":["\u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0906\u0935\u0936\u094d\u092f\u0915"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u0906\u092a\u0915\u0940 Reviewbird \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964 \u0938\u0947\u0935\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u093f\u0902\u0917 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Update Billing":["\u092c\u093f\u0932\u093f\u0902\u0917 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902"],"Connection Issue Detected":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e \u092a\u093e\u0908 \u0917\u0908"],"Unable to connect to Reviewbird. Please check your connection settings.":["Reviewbird \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"],"Fix Connection":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0920\u0940\u0915 \u0915\u0930\u0947\u0902"],"Unable to reach Reviewbird API. Please check your internet connection.":["Reviewbird API \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"],"Get Help":["\u092e\u0926\u0926 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902"],"Checking connection...":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a \u0930\u0939\u093e \u0939\u0948..."],"Verifying connection to Reviewbird...":["Reviewbird \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948..."],"Open Reviewbird":["Reviewbird \u0916\u094b\u0932\u0947\u0902"],"Connection Issue (%s)":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e (%s)"],"Refresh":["\u0930\u093f\u092b\u094d\u0930\u0947\u0936 \u0915\u0930\u0947\u0902"],"Last checked: %s":["\u0905\u0902\u0924\u093f\u092e \u091c\u093e\u0902\u091a: %s"],"Failed to update setting. Please try again.":["\u0938\u0947\u091f\u093f\u0902\u0917 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"],"Connected Store Settings":["\u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 \u0938\u094d\u091f\u094b\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Manage your Reviewbird integration with WooCommerce.":["\u0905\u092a\u0928\u0947 Reviewbird \u090f\u0915\u0940\u0915\u0930\u0923 \u0915\u094b WooCommerce \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"],"Reviewbird Widget":["Reviewbird \u0935\u093f\u091c\u0947\u091f"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 Reviewbird \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0935\u093f\u091c\u0947\u091f \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 \u0935\u093f\u091c\u0947\u091f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u0928\u0908 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"],"Widget is enabled on all WooCommerce product pages.":["\u0935\u093f\u091c\u0947\u091f \u0938\u092d\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0964"],"Forcefully enable reviews on all products":["\u0938\u092d\u0940 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u092a\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u094b \u091c\u092c\u0930\u0926\u0938\u094d\u0924\u0940 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u092f\u0926\u093f \u0906\u092a \"\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\" \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u093e \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0907\u0938\u0947 \u092c\u0902\u0926 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964"],"SEO Schema Markup":["SEO \u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 Google-\u0905\u0928\u0941\u0930\u0942\u092a \u0938\u0902\u0930\u091a\u093f\u0924 \u0921\u0947\u091f\u093e (JSON-LD \u0938\u094d\u0915\u0940\u092e\u093e) \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0916\u094b\u091c \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u092e\u0947\u0902 \u0930\u093f\u091a \u0938\u094d\u0928\u093f\u092a\u0947\u091f\u094d\u0938 \u0926\u093f\u0916 \u0938\u0915\u0947\u0902\u0964"],"Schema markup is active on all WooCommerce product pages.":["\u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u0938\u092d\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964"],"What is Schema Markup?":["\u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u0915\u094d\u092f\u093e \u0939\u0948?"],"Displays star ratings in Google search results":["Google \u0916\u094b\u091c \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u091f\u093e\u0930 \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948"],"Shows review counts and product information":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0923\u0928\u093e \u0914\u0930 \u0909\u0924\u094d\u092a\u093e\u0926 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948"],"Review schema is cached for 4 hours for optimal performance":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u094d\u0915\u0940\u092e\u093e \u092c\u0947\u0939\u0924\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f 4 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u0936 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948"],"Test with Google Rich Results":["Google \u0930\u093f\u091a \u0930\u093f\u091c\u0932\u094d\u091f\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902"],"Validate Schema":["\u0938\u094d\u0915\u0940\u092e\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"],"Enabled":["\u0938\u0915\u094d\u0937\u092e"],"Disabled":["\u0905\u0915\u094d\u0937\u092e"],"The plugin is installed!":["\u092a\u094d\u0932\u0917\u0907\u0928 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0939\u094b \u0917\u092f\u093e \u0939\u0948!"],"Your store is connected to Reviewbird":["\u0906\u092a\u0915\u0940 \u0926\u0941\u0915\u093e\u0928 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0939\u0941\u0908 \u0939\u0948"],"Now let's connect Reviewbird to your WooCommerce store.":["\u0905\u092c \u091a\u0932\u093f\u090f Reviewbird \u0915\u094b \u0906\u092a\u0915\u0940 WooCommerce \u0926\u0941\u0915\u093e\u0928 \u0938\u0947 \u091c\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964"],"Continue in Reviewbird to customize your widget and review request emails.":["\u0905\u092a\u0928\u0947 \u0935\u093f\u091c\u0947\u091f \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0908\u092e\u0947\u0932 \u0915\u094b \u0915\u0938\u094d\u091f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Reviewbird \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902\u0964"],"Continue setup":["\u0938\u0947\u091f\u0905\u092a \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902"],"Your store is connected":["\u0906\u092a\u0915\u0940 \u0926\u0941\u0915\u093e\u0928 \u091c\u0941\u0921\u093c\u0940 \u0939\u0941\u0908 \u0939\u0948"],"Manage your reviews, widgets, showcases and other settings in the dashboard.":["\u0905\u092a\u0928\u0947 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902, \u0935\u093f\u091c\u0947\u091f\u094d\u0938, \u0936\u094b\u0915\u0947\u0938 \u0914\u0930 \u0905\u0928\u094d\u092f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u094b \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092e\u0947\u0902 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"],"Open dashboard":["\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0916\u094b\u0932\u0947\u0902"],"Bring your reviews with you":["\u0905\u092a\u0928\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u0905\u092a\u0928\u0947 \u0938\u093e\u0925 \u0932\u093e\u090f\u0902"],"Import from WooCommerce, Judge.me, Yotpo, and many more.":["WooCommerce, Judge.me, Yotpo, \u0914\u0930 \u0915\u0908 \u0905\u0928\u094d\u092f \u0938\u0947 \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902\u0964"],"Photo and video reviews":["\u092b\u094b\u091f\u094b \u0914\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902"],"Allow customers to upload photos and videos of your product in real life.":["\u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u0906\u092a\u0915\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u0940 \u0905\u0938\u0932\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u0915\u0940 \u092b\u094b\u091f\u094b \u0914\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964"],"Match your branding":["\u0905\u092a\u0928\u0947 \u092c\u094d\u0930\u093e\u0902\u0921\u093f\u0902\u0917 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u090f\u0902"],"Customize your emails, widgets, and showcases to match your brand.":["\u0905\u092a\u0928\u0947 \u0908\u092e\u0947\u0932, \u0935\u093f\u091c\u0947\u091f\u094d\u0938, \u0914\u0930 \u0936\u094b\u0915\u0947\u0938 \u0915\u094b \u0905\u092a\u0928\u0947 \u092c\u094d\u0930\u093e\u0902\u0921 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0915\u0938\u094d\u091f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0947\u0902\u0964"],"Already use Reviewbird?":["\u092a\u0939\u0932\u0947 \u0938\u0947 Reviewbird \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902?"],"Sign in":["\u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0947\u0902"],"Loading Reviewbird\u2026":["Reviewbird \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u2026"],"(opens in a new tab)":["(\u0928\u0908 \u091f\u0948\u092c \u092e\u0947\u0902 \u0916\u0941\u0932\u0924\u093e \u0939\u0948)"],"Plugin settings":["\u092a\u094d\u0932\u0917\u0907\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Let's turn your WooCommerce product reviews up to 11.":["\u0906\u0907\u090f \u0906\u092a\u0915\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902 \u0915\u094b 11 \u0924\u0915 \u092c\u0922\u093c\u093e\u090f\u0902\u0964"],"Automated review requests help you collect reviews automatically after each order. No busywork, just reliable review collection on autopilot.":["\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0906\u092a\u0915\u094b \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0911\u0930\u094d\u0921\u0930 \u0915\u0947 \u092c\u093e\u0926 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094b\u0908 \u0935\u094d\u092f\u0938\u094d\u0924\u0924\u093e \u0928\u0939\u0940\u0902, \u092c\u0938 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u0902\u0917\u094d\u0930\u0939 \u0911\u091f\u094b\u092a\u093e\u092f\u0932\u091f \u092a\u0930\u0964"],"Get started free":["\u092e\u0941\u092b\u094d\u0924 \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902"],"Example Reviewbird product review request email":["Example Reviewbird \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0908\u092e\u0947\u0932"],"Reviewbird <store>for Aster & Oak<\/store>":["Reviewbird <store>for Aster & Oak<\/store>"],"To: jamie@example.com":["\u092a\u094d\u0930\u0924\u093f: jamie@example.com"],"Review request":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927"],"How is your new blanket?":["\u0906\u092a\u0915\u0940 \u0928\u0908 \u0915\u0902\u092c\u0932 \u0915\u0948\u0938\u0940 \u0939\u0948?"],"Share your experience to help other shoppers choose.":["\u0905\u0928\u094d\u092f \u0916\u0930\u0940\u0926\u093e\u0930\u094b\u0902 \u0915\u094b \u091a\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0905\u0928\u0941\u092d\u0935 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964"],"Linen Throw Blanket, Sage":["\u0932\u093f\u0928\u0928 \u0925\u094d\u0930\u094b \u0915\u0902\u092c\u0932, \u0938\u0947\u091c"],"Poor":["\u0916\u0930\u093e\u092c"],"Great":["\u092c\u0939\u0941\u0924 \u0905\u091a\u094d\u091b\u093e"],"You received this review request after your purchase from Aster & Oak.":["\u0906\u092a\u0915\u094b \u092f\u0939 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927 Aster & Oak \u0938\u0947 \u0906\u092a\u0915\u0940 \u0916\u0930\u0940\u0926 \u0915\u0947 \u092c\u093e\u0926 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u0906 \u0939\u0948\u0964"],"Unsubscribe from review emails":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0908\u092e\u0947\u0932 \u0938\u0947 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902"]}}}