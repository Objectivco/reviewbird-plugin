{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi_IN","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird":["Reviewbird"],"Reviewbird Settings":["Reviewbird \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Connected to Reviewbird":["Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u0906\u092a\u0915\u093e WooCommerce \u0938\u094d\u091f\u094b\u0930 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 \u0939\u0948\u0964 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e \u0938\u0939\u0940 \u0922\u0902\u0917 \u0938\u0947 \u0938\u093f\u0902\u0915 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964"],"View Dashboard":["\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u0947\u0902"],"WooCommerce Not Connected":["WooCommerce \u091c\u0941\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0939\u0948"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u0905\u092d\u0940 \u0924\u0915 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0938\u094d\u091f\u094b\u0930 \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0909\u0924\u094d\u092a\u093e\u0926 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u0938\u093f\u0902\u0915 \u0939\u094b \u0938\u0915\u0947\u0902\u0964"],"Connect WooCommerce":["WooCommerce \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902"],"Initial Sync in Progress":["\u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0938\u093f\u0902\u0915 \u092a\u094d\u0930\u0917\u0924\u093f \u092a\u0930 \u0939\u0948"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u0906\u092a\u0915\u0947 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902 \u0915\u094b \u0938\u093f\u0902\u0915 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u0915\u0948\u091f\u0932\u0949\u0917 \u0915\u0947 \u0906\u0915\u093e\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0907\u0938\u092e\u0947\u0902 \u0915\u0941\u091b \u092e\u093f\u0928\u091f \u0932\u0917 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u093f\u0902\u0915 \u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u092a\u0930 \u0935\u093f\u091c\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b\u0917\u093e\u0964"],"View Sync Progress":["\u0938\u093f\u0902\u0915 \u092a\u094d\u0930\u0917\u0924\u093f \u0926\u0947\u0916\u0947\u0902"],"Subscription Required":["\u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0906\u0935\u0936\u094d\u092f\u0915"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u0906\u092a\u0915\u0940 Reviewbird \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964 \u0938\u0947\u0935\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u093f\u0902\u0917 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Update Billing":["\u092c\u093f\u0932\u093f\u0902\u0917 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902"],"Connection Issue Detected":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e \u092a\u093e\u0908 \u0917\u0908"],"Unable to connect to Reviewbird. Please check your connection settings.":["Reviewbird \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"],"Fix Connection":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0920\u0940\u0915 \u0915\u0930\u0947\u0902"],"Unable to reach Reviewbird API. Please check your internet connection.":["Reviewbird API \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"],"Get Help":["\u092e\u0926\u0926 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902"],"Checking connection...":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a \u0930\u0939\u093e \u0939\u0948..."],"Verifying connection to Reviewbird...":["Reviewbird \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948..."],"Open Reviewbird":["Reviewbird \u0916\u094b\u0932\u0947\u0902"],"Connection Issue":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e"],"Refresh":["\u0930\u093f\u092b\u094d\u0930\u0947\u0936 \u0915\u0930\u0947\u0902"],"Last checked:":["\u0905\u0902\u0924\u093f\u092e \u091c\u093e\u0902\u091a:"],"Failed to update setting. Please try again.":["\u0938\u0947\u091f\u093f\u0902\u0917 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"],"Connected Store Settings":["\u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 \u0938\u094d\u091f\u094b\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Manage your Reviewbird integration with WooCommerce.":["\u0905\u092a\u0928\u0947 Reviewbird \u090f\u0915\u0940\u0915\u0930\u0923 \u0915\u094b WooCommerce \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"],"Reviewbird Widget":["Reviewbird \u0935\u093f\u091c\u0947\u091f"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 Reviewbird \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0935\u093f\u091c\u0947\u091f \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 \u0935\u093f\u091c\u0947\u091f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u0928\u0908 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"],"Widget is enabled on all WooCommerce product pages.":["\u0935\u093f\u091c\u0947\u091f \u0938\u092d\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0964"],"Forcefully enable reviews on all products":["\u0938\u092d\u0940 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u092a\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u094b \u091c\u092c\u0930\u0926\u0938\u094d\u0924\u0940 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u092f\u0926\u093f \u0906\u092a \"\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\" \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u093e \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0907\u0938\u0947 \u092c\u0902\u0926 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964"],"SEO Schema Markup":["SEO \u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 Google-\u0905\u0928\u0941\u0930\u0942\u092a \u0938\u0902\u0930\u091a\u093f\u0924 \u0921\u0947\u091f\u093e (JSON-LD \u0938\u094d\u0915\u0940\u092e\u093e) \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0916\u094b\u091c \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u092e\u0947\u0902 \u0930\u093f\u091a \u0938\u094d\u0928\u093f\u092a\u0947\u091f\u094d\u0938 \u0926\u093f\u0916 \u0938\u0915\u0947\u0902\u0964"],"Schema markup is active on all WooCommerce product pages.":["\u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u0938\u092d\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964"],"What is Schema Markup?":["\u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u0915\u094d\u092f\u093e \u0939\u0948?"],"Displays star ratings in Google search results":["Google \u0916\u094b\u091c \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u091f\u093e\u0930 \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948"],"Shows review counts and product information":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0923\u0928\u093e \u0914\u0930 \u0909\u0924\u094d\u092a\u093e\u0926 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948"],"Review schema is cached for 4 hours for optimal performance":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u094d\u0915\u0940\u092e\u093e \u092c\u0947\u0939\u0924\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f 4 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u0936 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948"],"Test with Google Rich Results":["Google \u0930\u093f\u091a \u0930\u093f\u091c\u0932\u094d\u091f\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902"],"Validate Schema":["\u0938\u094d\u0915\u0940\u092e\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"],"Enabled":["\u0938\u0915\u094d\u0937\u092e"],"Disabled":["\u0905\u0915\u094d\u0937\u092e"],"Create your free account":["\u0905\u092a\u0928\u093e \u092e\u0941\u092b\u094d\u0924 \u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0902"],"takes about a minute":["\u0932\u0917\u092d\u0917 \u090f\u0915 \u092e\u093f\u0928\u091f \u0932\u0917\u0924\u093e \u0939\u0948"],"Connect your WooCommerce site":["\u0905\u092a\u0928\u0947 WooCommerce \u0938\u093e\u0907\u091f \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902"],"one secure click":["\u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902"],"Turn on automatic review requests":["\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902"],"you set the timing and content":["\u0906\u092a \u0938\u092e\u092f \u0914\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902"],"Already have an account?":["\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0916\u093e\u0924\u093e \u0939\u0948?"],"Sign in":["\u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0947\u0902"],"Getting started":["\u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u093e"],"Turn your orders into powerful social proof.":["\u0905\u092a\u0928\u0947 \u0911\u0930\u094d\u0921\u0930 \u0915\u094b \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923 \u092e\u0947\u0902 \u092c\u0926\u0932\u0947\u0902\u0964"],"You're three quick steps from your first five-star review!":["\u0906\u092a\u0915\u0940 \u092a\u0939\u0932\u0940 \u092a\u093e\u0902\u091a-\u0938\u094d\u091f\u093e\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u0947 \u0906\u092a \u0924\u0940\u0928 \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u0926\u092e \u0926\u0942\u0930 \u0939\u0948\u0902!"],"Create free account":["\u092e\u0941\u092b\u094d\u0924 \u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0902"],"Free plan details":["\u092e\u0941\u092b\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0935\u093f\u0935\u0930\u0923"],"Free plan":["\u092e\u0941\u092b\u094d\u0924 \u092f\u094b\u091c\u0928\u093e"],"No credit card required":["\u0915\u094b\u0908 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0906\u0935\u0936\u094d\u092f\u0915 \u0928\u0939\u0940\u0902"],"25 review requests a month":["\u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 25 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927"],"Import your existing reviews":["\u0905\u092a\u0928\u0947 \u092e\u094c\u091c\u0942\u0926\u093e \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"],"Send a bulk request to past customers":["\u092a\u093f\u091b\u0932\u0947 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u092c\u0932\u094d\u0915 \u0905\u0928\u0941\u0930\u094b\u0927 \u092d\u0947\u091c\u0947\u0902"],"Built by the team behind CheckoutWC, trusted by <strong>8,000+ WooCommerce stores.<\/strong>":["CheckoutWC \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u091f\u0940\u092e \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u092e\u093f\u0924, <strong>8,000+ WooCommerce \u0938\u094d\u091f\u094b\u0930\u094d\u0938<\/strong> \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0964"],"Example Reviewbird product review request email":["Example Reviewbird \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0908\u092e\u0947\u0932"],"for Aster & Oak":["Aster & Oak \u0915\u0947 \u0932\u093f\u090f"],"To: jamie@example.com":["\u092a\u094d\u0930\u0924\u093f: jamie@example.com"],"Sent 3 days after delivery":["\u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0947 3 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092d\u0947\u091c\u093e \u0917\u092f\u093e"],"How would you rate this product?":["\u0906\u092a \u0907\u0938 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u094b \u0915\u0948\u0938\u0947 \u0930\u0947\u091f \u0915\u0930\u0947\u0902\u0917\u0947?"],"We would love it if you would share a bit about your experience.":["\u0939\u092e\u0947\u0902 \u0916\u0941\u0936\u0940 \u0939\u094b\u0917\u0940 \u092f\u0926\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0925\u094b\u0921\u093c\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964"],"Linen Throw Blanket \u2014 Sage":["\u0932\u093f\u0928\u0947\u0928 \u0925\u094d\u0930\u094b \u092c\u094d\u0932\u0948\u0902\u0915\u0947\u091f \u2014 \u0938\u0