{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi_IN","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["Reviewbird \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Connected to Reviewbird":["Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u0906\u092a\u0915\u093e WooCommerce \u0938\u094d\u091f\u094b\u0930 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 \u0939\u0948\u0964 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e \u0938\u0939\u0940 \u0922\u0902\u0917 \u0938\u0947 \u0938\u093f\u0902\u0915 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964"],"View Dashboard":["\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u0947\u0902"],"WooCommerce Not Connected":["WooCommerce \u091c\u0941\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0939\u0948"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u0905\u092d\u0940 \u0924\u0915 Reviewbird \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0938\u094d\u091f\u094b\u0930 \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0909\u0924\u094d\u092a\u093e\u0926 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u0938\u093f\u0902\u0915 \u0939\u094b \u0938\u0915\u0947\u0902\u0964"],"Connect WooCommerce":["WooCommerce \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902"],"Initial Sync in Progress":["\u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0938\u093f\u0902\u0915 \u092a\u094d\u0930\u0917\u0924\u093f \u092a\u0930 \u0939\u0948"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u0906\u092a\u0915\u0947 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902 \u0915\u094b \u0938\u093f\u0902\u0915 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u0915\u0948\u091f\u0932\u0949\u0917 \u0915\u0947 \u0906\u0915\u093e\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0907\u0938\u092e\u0947\u0902 \u0915\u0941\u091b \u092e\u093f\u0928\u091f \u0932\u0917 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u093f\u0902\u0915 \u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u092a\u0930 \u0935\u093f\u091c\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b\u0917\u093e\u0964"],"View Sync Progress":["\u0938\u093f\u0902\u0915 \u092a\u094d\u0930\u0917\u0924\u093f \u0926\u0947\u0916\u0947\u0902"],"Subscription Required":["\u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0906\u0935\u0936\u094d\u092f\u0915"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u0906\u092a\u0915\u0940 Reviewbird \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964 \u0938\u0947\u0935\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u093f\u0902\u0917 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Update Billing":["\u092c\u093f\u0932\u093f\u0902\u0917 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902"],"Connection Issue Detected":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e \u092a\u093e\u0908 \u0917\u0908"],"Unable to connect to Reviewbird. Please check your connection settings.":["Reviewbird \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"],"Fix Connection":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0920\u0940\u0915 \u0915\u0930\u0947\u0902"],"Unable to reach Reviewbird API. Please check your internet connection.":["Reviewbird API \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"],"Get Help":["\u092e\u0926\u0926 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902"],"Checking connection...":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a \u0930\u0939\u093e \u0939\u0948..."],"Verifying connection to Reviewbird...":["Reviewbird \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948..."],"Open Reviewbird":["Reviewbird \u0916\u094b\u0932\u0947\u0902"],"Connection Issue":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e"],"Refresh":["\u0930\u093f\u092b\u094d\u0930\u0947\u0936 \u0915\u0930\u0947\u0902"],"Last checked:":["\u0905\u0902\u0924\u093f\u092e \u091c\u093e\u0902\u091a:"],"Failed to update setting. Please try again.":["\u0938\u0947\u091f\u093f\u0902\u0917 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"],"Connected Store Settings":["\u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 \u0938\u094d\u091f\u094b\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Manage your Reviewbird integration with WooCommerce.":["\u0905\u092a\u0928\u0947 Reviewbird \u090f\u0915\u0940\u0915\u0930\u0923 \u0915\u094b WooCommerce \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"],"Reviewbird Widget":["Reviewbird \u0935\u093f\u091c\u0947\u091f"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 Reviewbird \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0935\u093f\u091c\u0947\u091f \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 \u0935\u093f\u091c\u0947\u091f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u0928\u0908 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"],"Widget is enabled on all WooCommerce product pages.":["\u0935\u093f\u091c\u0947\u091f \u0938\u092d\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0964"],"Forcefully enable reviews on all products":["\u0938\u092d\u0940 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u092a\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u094b \u091c\u092c\u0930\u0926\u0938\u094d\u0924\u0940 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u092f\u0926\u093f \u0906\u092a \"\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\" \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u093e \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0907\u0938\u0947 \u092c\u0902\u0926 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964"],"SEO Schema Markup":["SEO \u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 Google-\u0905\u0928\u0941\u0930\u0942\u092a \u0938\u0902\u0930\u091a\u093f\u0924 \u0921\u0947\u091f\u093e (JSON-LD \u0938\u094d\u0915\u0940\u092e\u093e) \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0916\u094b\u091c \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u092e\u0947\u0902 \u0930\u093f\u091a \u0938\u094d\u0928\u093f\u092a\u0947\u091f\u094d\u0938 \u0926\u093f\u0916 \u0938\u0915\u0947\u0902\u0964"],"Schema markup is active on all WooCommerce product pages.":["\u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u0938\u092d\u0940 WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964"],"What is Schema Markup?":["\u0938\u094d\u0915\u0940\u092e\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u0915\u094d\u092f\u093e \u0939\u0948?"],"Displays star ratings in Google search results":["Google \u0916\u094b\u091c \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u091f\u093e\u0930 \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948"],"Shows review counts and product information":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0923\u0928\u093e \u0914\u0930 \u0909\u0924\u094d\u092a\u093e\u0926 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948"],"Review schema is cached for 4 hours for optimal performance":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u094d\u0915\u0940\u092e\u093e \u092c\u0947\u0939\u0924\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f 4 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u0936 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948"],"Test with Google Rich Results":["Google \u0930\u093f\u091a \u0930\u093f\u091c\u0932\u094d\u091f\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902"],"Validate Schema":["\u0938\u094d\u0915\u0940\u092e\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"],"Enabled":["\u0938\u0915\u094d\u0937\u092e"],"Disabled":["\u0905\u0915\u094d\u0937\u092e"],"Create your Reviewbird account":["\u0905\u092a\u0928\u093e Reviewbird \u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0902"],"Start with the free plan, then connect your WooCommerce store whenever you are ready.":["\u092e\u0941\u092b\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u091c\u092c \u0906\u092a \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0902 \u0924\u094b \u0905\u092a\u0928\u093e WooCommerce \u0938\u094d\u091f\u094b\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964"],"Authorize your WooCommerce store":["\u0905\u092a\u0928\u0947 WooCommerce \u0938\u094d\u091f\u094b\u0930 \u0915\u094b \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0930\u0947\u0902"],"Connect Reviewbird so it can securely sync products, orders, and review activity.":["Reviewbird \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u092f\u0939 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902, \u0906\u0926\u0947\u0936\u094b\u0902 \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0915\u094b \u0938\u093f\u0902\u0915 \u0915\u0930 \u0938\u0915\u0947\u0964"],"Turn on your review experience":["\u0905\u092a\u0928\u093e \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0928\u0941\u092d\u0935 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902"],"Enable the widget in WordPress and start collecting polished, conversion-friendly product reviews.":["WordPress \u092e\u0947\u0902 \u0935\u093f\u091c\u0947\u091f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u0930\u093f\u0937\u094d\u0915\u0943\u0924, \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u0923-\u0905\u0928\u0941\u0915\u0942\u0932 \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"],"Step":["\u091a\u0930\u0923"],"Welcome to Reviewbird for WooCommerce":["WooCommerce \u0915\u0947 \u0932\u093f\u090f Reviewbird \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948"],"Collect more reviews with less friction.":["\u0915\u092e \u092c\u093e\u0927\u093e \u0915\u0947 \u0938\u093e\u0925 \u0905\u0927\u093f\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0947\u0902\u0964"],"Reviewbird helps WooCommerce merchants collect, moderate, and showcase product reviews with a polished experience that feels native to their storefront.":["Reviewbird WooCommerce \u0935\u093f\u0915\u094d\u0930\u0947\u0924\u093e\u0913\u0902 \u0915\u094b \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u0947, \u092e\u0949\u0921\u0930\u0947\u091f \u0915\u0930\u0928\u0947 \u0914\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948, \u090f\u0915 \u092a\u0930\u093f\u0937\u094d\u0915\u0943\u0924 \u0905\u0928\u0941\u092d\u0935 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b \u0909\u0928\u0915\u0947 \u0938\u094d\u091f\u094b\u0930\u092b\u094d\u0930\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0932\u0917\u0924\u093e \u0939\u0948\u0964"],"Get Started Free":["\u092e\u0941\u092b\u094d\u0924 \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902"],"Free plan available. Create your account first, then connect WooCommerce when you are ready.":["\u092e\u0941\u092b\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0902, \u092b\u093f\u0930 \u091c\u092c \u0906\u092a \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0902 WooCommerce \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964"],"Already have an account?":["\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0916\u093e\u0924\u093e \u0939\u0948?"],"Connect your store":["\u0905\u092a\u0928\u093e \u0938\u094d\u091f\u094b\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902"],"Need help getting set up?":["\u0938\u0947\u091f\u0905\u092a \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f?"],"Read the documentation":["\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u0922\u093c\u0947\u0902"],"See It In Action":["\u0907\u0938\u0947 \u0915\u094d\u0930\u093f\u092f\u093e\u0928\u094d\u0935\u093f\u0924 \u0926\u0947\u0916\u0947\u0902"],"A quick look at the Reviewbird widget":["Reviewbird \u0935\u093f\u091c\u0947\u091f \u092a\u0930 \u090f\u0915 \u0924\u094d\u0935\u0930\u093f\u0924 \u0928\u091c\u093c\u0930"],"Leaving a review shouldn't feel like applying for a loan. Our widget makes review submission easy and painless.":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u091b\u094b\u0921\u093c\u0928\u093e \u090b\u0923 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0928\u0947 \u091c\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0939\u092e\u093e\u0930\u093e \u0935\u093f\u091c\u0947\u091f \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0938\u092c\u092e\u093f\u0936\u0928 \u0915\u094b \u0906\u0938\u093e\u0928 \u0914\u0930 \u0926\u0930\u094d\u0926\u0930\u0939\u093f\u0924 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964"],"Reviewbird onboarding video":["Reviewbird \u0911\u0928\u092c\u094b\u0930\u094d\u0921\u093f\u0902\u0917 \u0935\u0940\u0921\u093f\u092f\u094b"],"Setup":["\u0938\u0947\u091f\u0905\u092a"],"Go live in three quick steps.":["\u0924\u0940\u0928 \u0924\u094d\u0935\u0930\u093f\u0924 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0932\u093e\u0907\u0935 \u091c\u093e\u090f\u0902\u0964"],"Create your account, connect WooCommerce, then":["\u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0902, WooCommerce \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u092b\u093f\u0930"],"enable the widget in settings":["\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0935\u093f\u091c\u0947\u091f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"]}}}