442\u0440\u0430\u043d\u0438\u0446\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0438"],"Ask customers to consent to Google Customer Reviews.":["\u0417\u0430\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044c \u0443 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u043d\u0430 Google Customer Reviews."],"Requires the Google Customer Reviews integration to be enabled. If you just enabled it, use Refresh to update the status.":["\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044e \u0441 Google Customer Reviews. \u0415\u0441\u043b\u0438 \u0432\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u0435\u0451 \u0432\u043a\u043b\u044e\u0447\u0438\u043b\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u0434\u043b\u044f \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u0442\u0443\u0441\u0430."],"Configure integration":["\u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044e"],"Refresh integration status":["\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u0441\u0442\u0430\u0442\u0443\u0441 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438"],"Customize your widget":["\u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0432\u0438\u0434\u0436\u0435\u0442"],"Widget preview":["\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0432\u0438\u0434\u0436\u0435\u0442\u0430"],"Customer message preview":["\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u0430"],"Reset to defaults":["\u0421\u0431\u0440\u043e\u0441\u0438\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"],"Saving\u2026":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u2026"],"Save changes":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f"],"Reviewbird Widget":["\u0412\u0438\u0434\u0436\u0435\u0442 Reviewbird"],"Show customer reviews on product pages.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043e\u0442\u0437\u044b\u0432\u044b \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432."],"Enable reviews for all products":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043e\u0442\u0437\u044b\u0432\u044b \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432"],"Also show reviews on products with reviews turned off.":["\u0422\u0430\u043a\u0436\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043e\u0442\u0437\u044b\u0432\u044b \u043d\u0430 \u0442\u043e\u0432\u0430\u0440\u0430\u0445 \u0441 \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u043c\u0438 \u043e\u0442\u0437\u044b\u0432\u0430\u043c\u0438."],"Search results":["\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043f\u043e\u0438\u0441\u043a\u0430"],"Add review data that search engines can use for star ratings.":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435 \u043e\u0442\u0437\u044b\u0432\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0438\u0441\u043a\u043e\u0432\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043c\u043e\u0433\u0443\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0434\u043b\u044f \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432 \u0432 \u0432\u0438\u0434\u0435 \u0437\u0432\u0451\u0437\u0434."],"Test rich results":["\u0422\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b"],"Validate schema":["\u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0441\u0445\u0435\u043c\u0443"],"The plugin is installed!":["\u041f\u043b\u0430\u0433\u0438\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d!"],"Your store is connected to Reviewbird":["\u0412\u0430\u0448 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d \u043a Reviewbird"],"Now let's connect Reviewbird to your WooCommerce store.":["\u0422\u0435\u043f\u0435\u0440\u044c \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u043c Reviewbird \u043a \u0432\u0430\u0448\u0435\u043c\u0443 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443 WooCommerce."],"Continue in Reviewbird to customize your widget and review request emails.":["\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435 \u0432 Reviewbird, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0432\u0438\u0434\u0436\u0435\u0442 \u0438 \u043f\u0438\u0441\u044c\u043c\u0430 \u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u0430\u043c\u0438 \u043e\u0442\u0437\u044b\u0432\u043e\u0432."],"Continue setup":["\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443"],"Your store is connected":["\u0412\u0430\u0448 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d"],"Manage your reviews, widgets, showcases and other settings in the dashboard.":["\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0441\u0432\u043e\u0438\u043c\u0438 \u043e\u0442\u0437\u044b\u0432\u0430\u043c\u0438, \u0432\u0438\u0434\u0436\u0435\u0442\u0430\u043c\u0438, \u0432\u0438\u0442\u0440\u0438\u043d\u0430\u043c\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u043c\u0438 \u0432 \u043f\u0430\u043d\u0435\u043b\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f."],"Open dashboard":["\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u0430\u043d\u0435\u043b\u044c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f"],"Bring your reviews with you":["\u0411\u0435\u0440\u0438\u0442\u0435 \u043e\u0442\u0437\u044b\u0432\u044b \u0441 \u0441\u043e\u0431\u043e\u0439"],"Import from WooCommerce, Judge.me, Yotpo, and many more.":["\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0438\u0437 WooCommerce, Judge.me, Yotpo \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445."],"Photo and video reviews":["\u0424\u043e\u0442\u043e- \u0438 \u0432\u0438\u0434\u0435\u043e\u043e\u0442\u0437\u044b\u0432\u044b"],"Allow customers to upload photos and videos of your product in real life.":["\u041f\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0442\u044c \u0444\u043e\u0442\u043e \u0438 \u0432\u0438\u0434\u0435\u043e \u0432\u0430\u0448\u0435\u0433\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438."],"Match your branding":["\u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u0430\u0448\u0435\u043c\u0443 \u0431\u0440\u0435\u043d\u0434\u0443"],"Customize your emails, widgets, and showcases to match your brand.":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u043f\u0438\u0441\u044c\u043c\u0430, \u0432\u0438\u0434\u0436\u0435\u0442\u044b \u0438 \u0432\u0438\u0442\u0440\u0438\u043d\u044b \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0432\u0430\u0448\u0438\u043c \u0431\u0440\u0435\u043d\u0434\u043e\u043c."],"Already use Reviewbird?":["\u0423\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0435 Reviewbird?"],"Sign in":["\u0412\u043e\u0439\u0442\u0438"],"Loading Reviewbird\u2026":["\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430 Reviewbird\u2026"],"(opens in a new tab)":["(\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043d\u043e\u0432\u043e\u0439 \u0432\u043a\u043b\u0430\u0434\u043a\u0435)"],"Plugin settings":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043f\u043b\u0430\u0433\u0438\u043d\u0430"],"Let's turn your WooCommerce product reviews up to 11.":["\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u0434\u0435\u043b\u0430\u0435\u043c \u043e\u0442\u0437\u044b\u0432\u044b \u043e \u0432\u0430\u0448\u0438\u0445 \u0442\u043e\u0432\u0430\u0440\u0430\u0445 WooCommerce \u043d\u0430 \u0432\u044b\u0441\u0448\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0435."],"Automated review requests help you collect reviews automatically after each order. No busywork, just reliable review collection on autopilot.":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u043f\u0440\u043e\u0441\u044b \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u043e\u0442\u0437\u044b\u0432\u044b \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430. \u041d\u0438\u043a\u0430\u043a\u043e\u0439 \u043b\u0438\u0448\u043d\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b, \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0434\u0435\u0436\u043d\u044b\u0439 \u0441\u0431\u043e\u0440 \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u043d\u0430 \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442\u0435."],"Get started free":["\u041d\u0430\u0447\u0430\u0442\u044c \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e"],"Example Reviewbird product review request email":["\u041f\u0440\u0438\u043c\u0435\u0440 \u043f\u0438\u0441\u044c\u043c\u0430 \u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u043c \u043e\u0442\u0437\u044b\u0432\u0430 \u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0435 Reviewbird"],"Reviewbird <store>for Aster & Oak<\/store>":["Reviewbird <store>\u0434\u043b\u044f Aster & Oak<\/store>"],"To: jamie@example.com":["\u041a\u043e\u043c\u0443: jamie@example.com"],"Review request":["\u0417\u0430\u043f\u0440\u043e\u0441 \u043e\u0442\u0437\u044b\u0432\u0430"],"How is your new blanket?":["\u041a\u0430\u043a \u0432\u0430\u043c \u0432\u0430\u0448\u0435 \u043d\u043e\u0432\u043e\u0435 \u043e\u0434\u0435\u044f\u043b\u043e?"],"Share your experience to help other shoppers choose.":["\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u0441\u0432\u043e\u0438\u043c \u043e\u043f\u044b\u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f\u043c \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u044b\u0431\u043e\u0440."],"Linen Throw Blanket, Sage":["\u041b\u044c\u043d\u044f\u043d\u043e\u0435 \u043f\u043b\u0435\u0434-\u043e\u0434\u0435\u044f\u043b\u043e, \u0448\u0430\u043b\u0444\u0435\u0439"],"Poor":["\u041f\u043b\u043e\u0445\u043e"],"Great":["\u041e\u0442\u043b\u0438\u0447\u043d\u043e"],"You received this review request after your purchase from Aster & Oak.":["\u0412\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u044d\u0442\u043e\u0442 \u0437\u0430\u043f\u0440\u043e\u0441 \u043e\u0442\u0437\u044b\u0432\u0430 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0432 Aster & Oak."],"Unsubscribe from review emails":["\u041e\u0442\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u043f\u0438\u0441\u0435\u043c \u0441 \u043e\u0442\u0437\u044b\u0432\u0430\u043c\u0438"]}}}