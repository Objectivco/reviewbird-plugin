{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ru_RU","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 Reviewbird"],"The setting could not be saved. Please try again.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u043d\u043e\u0432\u0430."],"Google Customer Reviews":["Google Customer Reviews"],"Connected to Reviewbird":["\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u043a Reviewbird"],"View dashboard":["\u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0430\u043d\u0435\u043b\u044c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f"],"Your store is not connected":["\u0412\u0430\u0448 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d"],"Reviewbird is disabled until you connect your WooCommerce store.":["Reviewbird \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d, \u043f\u043e\u043a\u0430 \u0432\u044b \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0432\u0430\u0448 \u043c\u0430\u0433\u0430\u0437\u0438\u043d WooCommerce."],"Connect store":["\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043c\u0430\u0433\u0430\u0437\u0438\u043d"],"Your store is syncing":["\u0412\u0430\u0448 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f"],"Your products and reviews are syncing.":["\u0412\u0430\u0448\u0438 \u0442\u043e\u0432\u0430\u0440\u044b \u0438 \u043e\u0442\u0437\u044b\