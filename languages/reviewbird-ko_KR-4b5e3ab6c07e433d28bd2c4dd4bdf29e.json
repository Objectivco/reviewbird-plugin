{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird":["\ub9ac\ubdf0\ubc84\ub4dc"],"Reviewbird Settings":["\ub9ac\ubdf0\ubc84\ub4dc \uc124\uc815"],"Connected to Reviewbird":["\ub9ac\ubdf0\ubc84\ub4dc\uc5d0 \uc5f0\uacb0\ub428"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\uadc0\ud558\uc758 WooCommerce \uc2a4\ud1a0\uc5b4\uac00 \ub9ac\ubdf0\ubc84\ub4dc\uc5d0 \uc131\uacf5\uc801\uc73c\ub85c \uc5f0\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub9ac\ubdf0 \ub370\uc774\ud130\uac00 \uc815\uc0c1\uc801\uc73c\ub85c \ub3d9\uae30\ud654\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4."],"View Dashboard":["\ub300\uc2dc\ubcf4\ub4dc \ubcf4\uae30"],"WooCommerce Not Connected":["WooCommerce \ubbf8\uc5f0\uacb0"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce\uac00 \uc544\uc9c1 \ub9ac\ubdf0\ubc84\ub4dc\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc2a4\ud1a0\uc5b4\ub97c \uc5f0\uacb0\ud558\uc5ec \uc0c1\ud488\uacfc \ub9ac\ubdf0 \ub3d9\uae30\ud654\ub97c \uc2dc\uc791\ud558\uc138\uc694."],"Connect WooCommerce":["WooCommerce \uc5f0\uacb0"],"Initial Sync in Progress":["\ucd08\uae30 \ub3d9\uae30\ud654 \uc9c4\ud589 \uc911"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["\ub9ac\ubdf0\ubc84\ub4dc\uac00 \uadc0\ud558\uc758 \uc0c1\ud488\uacfc \ub9ac\ubdf0\ub97c \ub3d9\uae30\ud654\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uce74\ud0c8\ub85c\uadf8 \ud06c\uae30\uc5d0 \ub530\ub77c \uba87 \ubd84 \uc815\ub3c4 \uc18c\uc694\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3d9\uae30\ud654\uac00 \uc644\ub8cc\ub418\uba74 \uc704\uc82f\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."],"View Sync Progress":["\ub3d9\uae30\ud654 \uc9c4\ud589 \uc0c1\ud669 \ubcf4\uae30"],"Subscription Required":["\uad6c\ub3c5 \ud544\uc694"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\uadc0\ud558\uc758 \ub9ac\ubdf0\ubc84\ub4dc \uad6c\ub3c5\uc774 \ube44\ud65c\uc131 \uc0c1\ud0dc\uc785\ub2c8\ub2e4. \uc11c\ube44\uc2a4\ub97c \uacc4\uc18d \uc0ac\uc6a9\ud558\ub824\uba74 \uacb0\uc81c \uc815\ubcf4\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\uc138\uc694."],"Update Billing":["\uacb0\uc81c \uc815\ubcf4 \uc5c5\ub370\uc774\ud2b8"],"Connection Issue Detected":["\uc5f0\uacb0 \ubb38\uc81c \uac10\uc9c0\ub428"],"Unable to connect to Reviewbird. Please check your connection settings.":["\ub9ac\ubdf0\ubc84\ub4dc\uc5d0 \uc5f0\uacb0\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc5f0\uacb0 \uc124\uc815\uc744 \ud655\uc778\ud558\uc138\uc694."],"Fix Connection":["\uc5f0\uacb0 \uc218\uc815"],"Unable to reach Reviewbird API. Please check your internet connection.":["\ub9ac\ubdf0\ubc84\ub4dc API\uc5d0 \uc811\uadfc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uc138\uc694."],"Get Help":["\ub3c4\uc6c0 \ubc1b\uae30"],"Checking connection...":["\uc5f0\uacb0 \ud655\uc778 \uc911..."],"Verifying connection to Reviewbird...":["\ub9ac\ubdf0\ubc84\ub4dc \uc5f0\uacb0 \ud655\uc778 \uc911..."],"Open Reviewbird":["\ub9ac\ubdf0\ubc84\ub4dc \uc5f4\uae30"],"Connection Issue":["\uc5f0\uacb0 \ubb38\uc81c"],"Refresh":["\uc0c8\ub85c \uace0\uce68"],"Last checked:":["\ub9c8\uc9c0\ub9c9 \ud655\uc778:"],"Failed to update setting. Please try again.":["\uc124\uc815 \uc5c5\ub370\uc774\ud2b8 \uc2e4\ud328. \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."],"Connected Store Settings":["\uc5f0\uacb0\ub41c \uc2a4\ud1a0\uc5b4 \uc124\uc815"],"Manage your Reviewbird integration with WooCommerce.":["WooCommerce\uc640 \ud568\uaed8 Reviewbird \ud1b5\ud569\uc744 \uad00\ub9ac\ud558\uc138\uc694."],"Reviewbird Widget":["Reviewbird \uc704\uc82f"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\uc81c\ud488 \ud398\uc774\uc9c0\uc5d0 Reviewbird \ub9ac\ubdf0 \uc704\uc82f\uc744 \ud45c\uc2dc\ud569\ub2c8\ub2e4. \uc704\uc82f\uc740 \uace0\uac1d \ub9ac\ubdf0\ub97c \ubcf4\uc5ec\uc8fc\uace0 \uace0\uac1d\uc774 \uc0c8 \ub9ac\ubdf0\ub97c \uc81c\ucd9c\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."],"Widget is enabled on all WooCommerce product pages.":["\ubaa8\ub4e0 WooCommerce \uc81c\ud488 \ud398\uc774\uc9c0\uc5d0\uc11c \uc704\uc82f\uc774 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."],"Forcefully enable reviews on all products":["\ubaa8\ub4e0 \uc81c\ud488\uc5d0 \ub300\ud574 \ub9ac\ubdf0\ub97c \uac15\uc81c\ub85c \ud65c\uc131\ud654"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\uc81c\ud488\ubcc4\ub85c \"\ub9ac\ubdf0 \ud65c\uc131\ud654\" \uccb4\ud06c\ubc15\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub9ac\ubdf0\ub97c \uc81c\uc5b4\ud558\ub824\uba74 \uc774 \uc635\uc158\uc744 \ub044\uc2ed\uc2dc\uc624."],"SEO Schema Markup":["SEO \uc2a4\ud0a4\ub9c8 \ub9c8\ud06c\uc5c5"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\uac80\uc0c9 \uacb0\uacfc\uc758 \ub9ac\uce58 \uc2a4\ub2c8\ud3ab\uc744 \uc704\ud574 \uc81c\ud488 \ud398\uc774\uc9c0\uc5d0\uc11c Google \ud638\ud658 \uad6c\uc870\ud654 \ub370\uc774\ud130(JSON-LD \uc2a4\ud0a4\ub9c8)\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."],"Schema markup is active on all WooCommerce product pages.":["\ubaa8\ub4e0 WooCommerce \uc81c\ud488 \ud398\uc774\uc9c0\uc5d0\uc11c \uc2a4\ud0a4\ub9c8 \ub9c8\ud06c\uc5c5\uc774 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."],"What is Schema Markup?":["\uc2a4\ud0a4\ub9c8 \ub9c8\ud06c\uc5c5\uc774\ub780?"],"Displays star ratings in Google search results":["Google \uac80\uc0c9 \uacb0\uacfc\uc5d0 \ubcc4\uc810 \ud3c9\uac00\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4"],"Shows review counts and product information":["\ub9ac\ubdf0 \uc218\uc640 \uc81c\ud488 \uc815\ubcf4\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4"],"Review schema is cached for 4 hours for optimal performance":["\ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \ub9ac\ubdf0 \uc2a4\ud0a4\ub9c8\ub294 4\uc2dc\uac04 \ub3d9\uc548 \uce90\uc2dc\ub429\ub2c8\ub2e4"],"Test with Google Rich Results":["Google \ub9ac\uce58 \uacb0\uacfc\ub85c \ud14c\uc2a4\ud2b8"],"Validate Schema":["\uc2a4\ud0a4\ub9c8 \uac80\uc99d"],"Enabled":["\ud65c\uc131\ud654\ub428"],"Disabled":["\ube44\ud65c\uc131\ud654\ub428"],"Create your free account":[""],"takes about a minute":[""],"Connect your WooCommerce site":[""],"one secure click":[""],"Turn on review requests":[""],"choose when they go out":[""],"Already have an account?":[""],"Sign in":[""],"Getting started":[""],"You're three steps from your first five-star review.":[""],"Reviewbird emails customers after delivery and turns their feedback into product reviews on your WooCommerce site\u2014automatically.":[""],"Create free account":[""],"Free plan details":[""],"Free plan":[""],"No credit card required":[""],"25 review requests a month":[""],"Import your existing reviews":[""],"Built by the team behind CheckoutWC, trusted by <strong>8,000+ WooCommerce stores.<\/strong>":[""],"Example Reviewbird product review request email":[""],"for Aster & Oak":[""],"To: jamie@example.com":[""],"Sent 3 days after delivery":[""],"How would you rate this product?":[""],"We would love it if you would share a bit about your experience.":[""],"Linen Throw Blanket \u2014 Sage":[""],"Poor":[""],"Great":[""],"You received this email because you made a purchase from Aster & Oak.":[""],"Unsubscribe from review emails":[""]}}}