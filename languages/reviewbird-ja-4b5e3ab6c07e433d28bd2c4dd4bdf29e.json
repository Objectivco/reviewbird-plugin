{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["Reviewbird\u8a2d\u5b9a"],"Connected to Reviewbird":["Reviewbird\u306b\u63a5\u7d9a\u3055\u308c\u307e\u3057\u305f"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u3042\u306a\u305f\u306eWooCommerce\u30b9\u30c8\u30a2\u306fReviewbird\u306b\u6b63\u5e38\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30ec\u30d3\u30e5\u30fc\u306e\u30c7\u30fc\u30bf\u306f\u6b63\u5e38\u306b\u540c\u671f\u3055\u308c\u3066\u3044\u307e\u3059\u3002"],"View Dashboard":["\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u3092\u898b\u308b"],"WooCommerce Not Connected":["WooCommerce\u304c\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce\u306f\u307e\u3060Reviewbird\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30b9\u30c8\u30a2\u3092\u63a5\u7d9a\u3057\u3066\u5546\u54c1\u3068\u30ec\u30d3\u30e5\u30fc\u306e\u540c\u671f\u3092\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Connect WooCommerce":["WooCommerce\u3092\u63a5\u7d9a\u3059\u308b"],"Initial Sync in Progress":["\u521d\u671f\u540c\u671f\u4e2d"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird\u304c\u3042\u306a\u305f\u306e\u5546\u54c1\u3068\u30ec\u30d3\u30e5\u30fc\u3092\u540c\u671f\u3057\u3066\u3044\u307e\u3059\u3002\u30ab\u30bf\u30ed\u30b0\u306e\u30b5\u30a4\u30ba\u306b\u3088\u3063\u3066\u306f\u6570\u5206\u304b\u304b\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u540c\u671f\u304c\u5b8c\u4e86\u3059\u308b\u3068\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u304c\u5229\u7528\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002"],"View Sync Progress":["\u540c\u671f\u306e\u9032\u884c\u72b6\u6cc1\u3092\u898b\u308b"],"Subscription Required":["\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u304c\u5fc5\u8981\u3067\u3059"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u3042\u306a\u305f\u306eReviewbird\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u306f\u7121\u52b9\u3067\u3059\u3002\u30b5\u30fc\u30d3\u30b9\u3092\u7d99\u7d9a\u3057\u3066\u5229\u7528\u3059\u308b\u306b\u306f\u8acb\u6c42\u60c5\u5831\u3092\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Update Billing":["\u8acb\u6c42\u60c5\u5831\u3092\u66f4\u65b0\u3059\u308b"],"Connection Issue Detected":["\u63a5\u7d9a\u554f\u984c\u304c\u691c\u51fa\u3055\u308c\u307e\u3057\u305f"],"Unable to connect to Reviewbird. Please check your connection settings.":["Reviewbird\u306b\u63a5\u7d9a\u3067\u304d\u307e\u305b\u3093\u3002\u63a5\u7d9a\u8a2d\u5b9a\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Fix Connection":["\u63a5\u7d9a\u3092\u4fee\u6b63\u3059\u308b"],"Unable to reach Reviewbird API. Please check your internet connection.":["Reviewbird API\u306b\u5230\u9054\u3067\u304d\u307e\u305b\u3093\u3002\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Get Help":["\u30d8\u30eb\u30d7\u3092\u5f97\u308b"],"Checking connection...":["\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u3066\u3044\u307e\u3059..."],"Verifying connection to Reviewbird...":["Reviewbird\u3078\u306e\u63a5\u7d9a\u3092\u691c\u8a3c\u3057\u3066\u3044\u307e\u3059..."],"Open Reviewbird":["Reviewbird\u3092\u958b\u304f"],"Connection Issue":["\u63a5\u7d9a\u554f\u984c"],"Refresh":["\u66f4\u65b0"],"Last checked:":["\u6700\u7d42\u78ba\u8a8d\u65e5\u6642\uff1a"],"Failed to update setting. Please try again.":["\u8a2d\u5b9a\u306e\u66f4\u65b0\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"],"Connected Store Settings":["\u63a5\u7d9a\u3055\u308c\u305f\u30b9\u30c8\u30a2\u306e\u8a2d\u5b9a"],"Manage your Reviewbird integration with WooCommerce.":["WooCommerce\u3067Reviewbird\u306e\u7d71\u5408\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002"],"Reviewbird Widget":["Reviewbird\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u5546\u54c1\u30da\u30fc\u30b8\u306bReviewbird\u306e\u30ec\u30d3\u30e5\u30fc\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u3092\u8868\u793a\u3057\u307e\u3059\u3002\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u306f\u9867\u5ba2\u306e\u30ec\u30d3\u30e5\u30fc\u3092\u8868\u793a\u3057\u3001\u65b0\u3057\u3044\u30ec\u30d3\u30e5\u30fc\u306e\u6295\u7a3f\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002"],"Widget is enabled on all WooCommerce product pages.":["\u3059\u3079\u3066\u306eWooCommerce\u5546\u54c1\u30da\u30fc\u30b8\u3067\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002"],"Forcefully enable reviews on all products":["\u3059\u3079\u3066\u306e\u5546\u54c1\u3067\u30ec\u30d3\u30e5\u30fc\u3092\u5f37\u5236\u7684\u306b\u6709\u52b9\u306b\u3059\u308b"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u300c\u30ec\u30d3\u30e5\u30fc\u3092\u6709\u52b9\u306b\u3059\u308b\u300d\u30c1\u30a7\u30c3\u30af\u30dc\u30c3\u30af\u30b9\u3067\u5546\u54c1\u3054\u3068\u306b\u30ec\u30d3\u30e5\u30fc\u3092\u7ba1\u7406\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u30aa\u30d5\u306e\u307e\u307e\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"SEO Schema Markup":["SEO\u30b9\u30ad\u30fc\u30de\u30de\u30fc\u30af\u30a2\u30c3\u30d7"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u5546\u54c1\u30da\u30fc\u30b8\u3067Google\u6e96\u62e0\u306e\u69cb\u9020\u5316\u30c7\u30fc\u30bf\uff08JSON-LD\u30b9\u30ad\u30fc\u30de\uff09\u3092\u6709\u52b9\u306b\u3057\u3001\u691c\u7d22\u7d50\u679c\u306e\u30ea\u30c3\u30c1\u30b9\u30cb\u30da\u30c3\u30c8\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"Schema markup is active on all WooCommerce product pages.":["\u3059\u3079\u3066\u306eWooCommerce\u5546\u54c1\u30da\u30fc\u30b8\u3067\u30b9\u30ad\u30fc\u30de\u30de\u30fc\u30af\u30a2\u30c3\u30d7\u304c\u6709\u52b9\u3067\u3059\u3002"],"What is Schema Markup?":["\u30b9\u30ad\u30fc\u30de\u30de\u30fc\u30af\u30a2\u30c3\u30d7\u3068\u306f\uff1f"],"Displays star ratings in Google search results":["Google\u691c\u7d22\u7d50\u679c\u306b\u661f\u8a55\u4fa1\u3092\u8868\u793a\u3057\u307e\u3059"],"Shows review counts and product information":["\u30ec\u30d3\u30e5\u30fc\u6570\u3068\u5546\u54c1\u60c5\u5831\u3092\u8868\u793a\u3057\u307e\u3059"],"Review schema is cached for 4 hours for optimal performance":["\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u30ec\u30d3\u30e5\u30fc\u306e\u30b9\u30ad\u30fc\u30de\u306f4\u6642\u9593\u30ad\u30e3\u30c3\u30b7\u30e5\u3055\u308c\u307e\u3059"],"Test with Google Rich Results":["Google\u30ea\u30c3\u30c1\u30ea\u30b6\u30eb\u30c8\u3067\u30c6\u30b9\u30c8"],"Validate Schema":["\u30b9\u30ad\u30fc\u30de\u3092\u691c\u8a3c"],"Enabled":["\u6709\u52b9"],"Disabled":["\u7121\u52b9"],"Create your Reviewbird account":["Reviewbird\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b"],"Start with the free plan, then connect your WooCommerce store whenever you are ready.":["\u7121\u6599\u30d7\u30e9\u30f3\u304b\u3089\u59cb\u3081\u3066\u3001\u6e96\u5099\u304c\u3067\u304d\u305f\u3089WooCommerce\u30b9\u30c8\u30a2\u3092\u63a5\u7d9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Authorize your WooCommerce store":["WooCommerce\u30b9\u30c8\u30a2\u3092\u8a8d\u8a3c\u3059\u308b"],"Connect Reviewbird so it can securely sync products, orders, and review activity.":["Reviewbird\u3092\u63a5\u7d9a\u3057\u3066\u3001\u5546\u54c1\u3001\u6ce8\u6587\u3001\u30ec\u30d3\u30e5\u30fc\u6d3b\u52d5\u3092\u5b89\u5168\u306b\u540c\u671f\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"],"Turn on your review experience":["\u30ec\u30d3\u30e5\u30fc\u4f53\u9a13\u3092\u958b\u59cb\u3059\u308b"],"Enable the widget in WordPress and start collecting polished, conversion-friendly product reviews.":["WordPress\u3067\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u3092\u6709\u52b9\u306b\u3057\u3066\u3001\u6d17\u7df4\u3055\u308c\u305f\u30b3\u30f3\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u9069\u3057\u305f\u5546\u54c1\u30ec\u30d3\u30e5\u30fc\u306e\u53ce\u96c6\u3092\u958b\u59cb\u3057\u307e\u3059\u3002"],"Step":["\u30b9\u30c6\u30c3\u30d7"],"Welcome to Reviewbird for WooCommerce":["WooCommerce\u7528Reviewbird\u3078\u3088\u3046\u3053\u305d"],"Collect more reviews with less friction.":["\u3088\u308a\u5c11\u306a\u3044\u624b\u9593\u3067\u3088\u308a\u591a\u304f\u306e\u30ec\u30d3\u30e5\u30fc\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002"],"Reviewbird helps WooCommerce merchants collect, moderate, and showcase product reviews with a polished experience that feels native to their storefront.":["Reviewbird\u306fWooCommerce\u306e\u8ca9\u58f2\u8005\u304c\u5546\u54c1\u30ec\u30d3\u30e5\u30fc\u3092\u53ce\u96c6\u3001\u7ba1\u7406\u3001\u8868\u793a\u3059\u308b\u306e\u3092\u652f\u63f4\u3057\u3001\u5e97\u8217\u306b\u81ea\u7136\u306b\u99b4\u67d3\u3080\u6d17\u7df4\u3055\u308c\u305f\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"],"Get Started Free":["\u7121\u6599\u3067\u59cb\u3081\u308b"],"Free plan available. Create your account first, then connect WooCommerce when you are ready.":["\u7121\u6599\u30d7\u30e9\u30f3\u5229\u7528\u53ef\u80fd\u3002\u307e\u305a\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u3001\u6e96\u5099\u304c\u3067\u304d\u305f\u3089WooCommerce\u3092\u63a5\u7d9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Already have an account?":["\u3059\u3067\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u304a\u6301\u3061\u3067\u3059\u304b\uff1f"],"Connect your store":["\u30b9\u30c8\u30a2\u3092\u63a5\u7d9a\u3059\u308b"],"Need help getting set up?":["\u8a2d\u5b9a\u306e\u624b\u52a9\u3051\u304c\u5fc5\u8981\u3067\u3059\u304b\uff1f"],"Read the documentation":["\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u3092\u8aad\u3080"],"See It In Action":["\u5b9f\u969b\u306e\u52d5\u4f5c\u3092\u898b\u308b"],"A quick look at the Reviewbird widget":["Reviewbird\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u306e\u7c21\u5358\u306a\u7d39\u4ecb"],"Leaving a review shouldn't feel like applying for a loan. Our widget makes review submission easy and painless.":["\u30ec\u30d3\u30e5\u30fc\u3092\u66f8\u304f\u3053\u3068\u304c\u307e\u308b\u3067\u30ed\u30fc\u30f3\u306e\u7533\u8acb\u306e\u3088\u3046\u306b\u611f\u3058\u3089\u308c\u308b\u3079\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u5f53\u793e\u306e\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u306f\u3001\u30ec\u30d3\u30e5\u30fc\u306e\u6295\u7a3f\u3092\u7c21\u5358\u3067\u30b9\u30c8\u30ec\u30b9\u30d5\u30ea\u30fc\u306b\u3057\u307e\u3059\u3002"],"Reviewbird onboarding video":["Reviewbird\u30aa\u30f3\u30dc\u30fc\u30c7\u30a3\u30f3\u30b0\u30d3\u30c7\u30aa"],"Setup":["\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7"],"Go live in three quick steps.":["3\u3064\u306e\u7c21\u5358\u306a\u30b9\u30c6\u30c3\u30d7\u3067\u958b\u59cb\u3057\u307e\u3057\u3087\u3046\u3002"],"Create your account, connect WooCommerce, then":["\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u3001WooCommerce\u3092\u63a5\u7d9a\u3057\u3001"],"enable the widget in settings":["\u8a2d\u5b9a\u3067\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u3092\u6709\u52b9\u306b\u3057\u307e\u3059"]}}}