{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["Reviewbird\u8a2d\u5b9a"],"Connected to Reviewbird":["Reviewbird\u306b\u63a5\u7d9a\u3055\u308c\u307e\u3057\u305f"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u3042\u306a\u305f\u306eWooCommerce\u30b9\u30c8\u30a2\u306fReviewbird\u306b\u6b63\u5e38\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30ec\u30d3\u30e5\u30fc\u306e\u30c7\u30fc\u30bf\u306f\u6b63\u5e38\u306b\u540c\u671f\u3055\u308c\u3066\u3044\u307e\u3059\u3002"],"View Dashboard":["\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u3092\u898b\u308b"],"WooCommerce Not Connected":["WooCommerce\u304c\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce\u306f\u307e\u3060Reviewbird\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30b9\u30c8\u30a2\u3092\u63a5\u7d9a\u3057\u3066\u5546\u54c1\u3068\u30ec\u30d3\u30e5\u30fc\u306e\u540c\u671f\u3092\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Connect WooCommerce":["WooCommerce\u3092\u63a5\u7d9a\u3059\u308b"],"Initial Sync in Progress":["\u521d\u671f\u540c\u671f\u4e2d"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird\u304c\u3042\u306a\u305f\u306e\u5546\u54c1\u3068\u30ec\u30d3\u30e5\u30fc\u3092\u540c\u671f\u3057\u3066\u3044\u307e\u3059\u3002\u30ab\u30bf\u30ed\u30b0\u306e\u30b5\u30a4\u30ba\u306b\u3088\u3063\u3066\u306f\u6570\u5206\u304b\u304b\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u540c\u671f\u304c\u5b8c\u4e86\u3059\u308b\u3068\u30a6\u30a3\u30b8\u30a7\u30c3\u3