{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ar","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f"],"Connected to Reviewbird":["\u0645\u062a\u0635\u0644 \u0628\u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u0645\u062a\u062c\u0631\u0643 WooCommerce \u0645\u062a\u0635\u0644 \u0628\u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f \u0628\u0646\u062c\u0627\u062d. \u064a\u062a\u0645 \u0645\u0632\u0627\u0645\u0646\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d."],"View Dashboard":["\u0639\u0631\u0636 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"WooCommerce Not Connected":["WooCommerce \u063a\u064a\u0631 \u0645\u062a\u0635\u0644"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["\u0644\u0645 \u064a\u062a\u0645 \u062a\u0648\u0635\u064a\u0644 WooCommerce \u0628\u0639\u062f \u0628\u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f. \u0642\u0645 \u0628\u062a\u0648\u0635\u064a\u0644 \u0645\u062a\u062c\u0631\u0643 \u0644\u0628\u062f\u0621 \u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a."],"Connect WooCommerce":["\u062a\u0648\u0635\u064a\u0644 WooCommerce"],"Initial Sync in Progress":["\u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u062c\u0627\u0631\u064a\u0629"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["\u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f \u064a\u0642\u0648\u0645 \u0628\u0645\u0632\u0627\u0645\u0646\u0629 \u0645\u0646\u062a\u062c\u0627\u062a\u0643 \u0648\u0645\u0631\u0627\u062c\u0639\u0627\u062a\u0643. \u0642\u062f \u064a\u0633\u062a\u063a\u0631\u0642 \u0647\u0630\u0627 \u0628\u0636\u0639 \u062f\u0642\u0627\u0626\u0642 \u062d\u0633\u0628 \u062d\u062c\u0645 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u062e\u0627\u0635 \u0628\u0643. \u0633\u064a\u0643\u0648\u0646 \u0627\u0644\u0648\u062f\u062c\u062a \u0645\u062a\u0627\u062d\u064b\u0627 \u0628\u0645\u062c\u0631\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629."],"View Sync Progress":["\u0639\u0631\u0636 \u062a\u0642\u062f\u0645 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Subscription Required":["\u0627\u0634\u062a\u0631\u0627\u0643 \u0645\u0637\u0644\u0648\u0628"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u0627\u0634\u062a\u0631\u0627\u0643\u0643 \u0641\u064a \u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f \u063a\u064a\u0631 \u0646\u0634\u0637. \u064a\u0631\u062c\u0649 \u062a\u062d\u062f\u064a\u062b \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0641\u0648\u062a\u0631\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0644\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062e\u062f\u0645\u0629."],"Update Billing":["\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0641\u0648\u062a\u0631\u0629"],"Connection Issue Detected":["\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Unable to connect to Reviewbird. Please check your connection settings.":["\u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643."],"Fix Connection":["\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Unable to reach Reviewbird API. Please check your internet connection.":["\u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 API \u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0627\u0644\u062e\u0627\u0635 \u0628\u0643."],"Get Help":["\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629"],"Checking connection...":["\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644..."],"Verifying connection to Reviewbird...":["\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f..."],"Open Reviewbird":["\u0641\u062a\u062d \u0631\u064a\u0641\u064a\u0648\u0628\u064a\u0631\u062f"],"Connection Issue (%s)":["\u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 (%s)"],"Refresh":["\u062a\u062d\u062f\u064a\u062b"],"Last checked: %s":["\u0622\u062e\u0631 \u0641\u062d\u0635: %s"],"Failed to update setting. Please try again.":["\u0641\u0634\u0644 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0625\u0639\u062f\u0627\u062f. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Connected Store Settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u062c\u0631 \u0627\u0644\u0645\u062a\u0635\u0644"],"Manage your Reviewbird integration with WooCommerce.":["\u0642\u0645 \u0628\u0625\u062f\u0627\u0631\u0629 \u062a\u0643\u0627\u0645\u0644 Reviewbird \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0645\u0639 WooCommerce."],"Reviewbird Widget":["\u0623\u062f\u0627\u0629 Reviewbird"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u0639\u0631\u0636 \u0623\u062f\u0627\u0629 \u0645\u0631\u0627\u062c\u0639\u0629 Reviewbird \u0639\u0644\u0649 \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a. \u062a\u0639\u0631\u0636 \u0627\u0644\u0623\u062f\u0627\u0629 \u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0648\u062a\u0633\u0645\u062d \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0628\u062a\u0642\u062f\u064a\u0645 \u0645\u0631\u0627\u062c\u0639\u0627\u062a \u062c\u062f\u064a\u062f\u0629."],"Widget is enabled on all WooCommerce product pages.":["\u0627\u0644\u0623\u062f\u0627\u0629 \u0645\u0641\u0639\u0644\u0629 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0635\u0641\u062d\u0627\u062a \u0645\u0646\u062a\u062c\u0627\u062a WooCommerce."],"Forcefully enable reviews on all products":["\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0628\u0627\u0644\u0642\u0648\u0629 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u0627\u062a\u0631\u0643 \u0647\u0630\u0627 \u0645\u0639\u0637\u0644\u0627\u064b \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0641\u0636\u0644 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0644\u0643\u0644 \u0645\u0646\u062a\u062c \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0631\u0628\u0639 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a\"."],"SEO Schema Markup":["\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0637\u0637 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO)"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 Google (\u0645\u062e\u0637\u0637 JSON-LD) \u0639\u0644\u0649 \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0644\u0639\u0631\u0636 \u0645\u0642\u062a\u0637\u0641\u0627\u062a \u063a\u0646\u064a\u0629 \u0641\u064a \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0628\u062d\u062b."],"Schema markup is active on all WooCommerce product pages.":["\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u062e\u0637\u0637 \u0646\u0634\u0637\u0629 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0635\u0641\u062d\u0627\u062a \u0645\u0646\u062a\u062c\u0627\u062a WooCommerce."],"What is Schema Markup?":["\u0645\u0627 \u0647\u064a \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u062e\u0637\u0637\u061f"],"Displays star ratings in Google search results":["\u064a\u0639\u0631\u0636 \u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0627\u0644\u0646\u062c\u0648\u0645 \u0641\u064a \u0646\u062a\u0627\u0626\u062c \u0628\u062d\u062b Google"],"Shows review counts and product information":["\u064a\u0639\u0631\u0636 \u0639\u062f\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0648\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c"],"Review schema is cached for 4 hours for optimal performance":["\u064a\u062a\u0645 \u062a\u062e\u0632\u064a\u0646 \u0645\u062e\u0637\u0637 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0645\u0624\u0642\u062a\u064b\u0627 \u0644\u0645\u062f\u0629 4 \u0633\u0627\u0639\u0627\u062a \u0644\u0623\u062f\u0627\u0621 \u0645\u062b\u0627\u0644\u064a"],"Test with Google Rich Results":["\u0627\u062e\u062a\u0628\u0631 \u0645\u0639 \u0646\u062a\u0627\u0626\u062c Google \u0627\u0644\u063a\u0646\u064a\u0629"],"Validate Schema":["\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u062d\u0629 \u0627\u0644\u0645\u062e\u0637\u0637"],"Enabled":["\u0645\u0641\u0639\u0644"],"Disabled":["\u0645\u0639\u0637\u0644"],"The plugin is installed!":["\u062a\u0645 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629!"],"Your store is connected to Reviewbird":["\u0645\u062a\u062c\u0631\u0643 \u0645\u062a\u0635\u0644 \u0628\u0640 Reviewbird"],"Now let's connect Reviewbird to your WooCommerce store.":["\u0644\u0646\u0642\u0645 \u0627\u0644\u0622\u0646 \u0628\u0631\u0628\u0637 Reviewbird \u0628\u0645\u062a\u062c\u0631\u0643 \u0639\u0644\u0649 WooCommerce."],"Continue in Reviewbird to customize your widget and review request emails.":["\u062a\u0627\u0628\u0639 \u0641\u064a Reviewbird \u0644\u062a\u062e\u0635\u064a\u0635 \u0639\u0646\u0635\u0631 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0648\u0631\u0633\u0627\u0626\u0644 \u0637\u0644\u0628 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629."],"Continue setup":["\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0625\u0639\u062f\u0627\u062f"],"Your store is connected":["\u0645\u062a\u062c\u0631\u0643 \u0645\u062a\u0635\u0644"],"Manage your reviews, widgets, showcases and other settings in the dashboard.":["\u0642\u0645 \u0628\u0625\u062f\u0627\u0631\u0629 \u0645\u0631\u0627\u062c\u0639\u0627\u062a\u0643\u060c \u0648\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0648\u0627\u062c\u0647\u0629\u060c \u0648\u0627\u0644\u0639\u0631\u0648\u0636\u060c \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645."],"Open dashboard":["\u0627\u0641\u062a\u062d \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"Bring your reviews with you":["\u0627\u062d\u0636\u0631 \u0645\u0631\u0627\u062c\u0639\u0627\u062a\u0643 \u0645\u0639\u0643"],"Import from WooCommerce, Judge.me, Yotpo, and many more.":["\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 WooCommerce \u0648 Judge.me \u0648 Yotpo \u0648\u0627\u0644\u0639\u062f\u064a\u062f \u063a\u064a\u0631\u0647\u0627."],"Photo and video reviews":["\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0641\u064a\u062f\u064a\u0648"],"Allow customers to upload photos and videos of your product in real life.":["\u0627\u0633\u0645\u062d \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0628\u062a\u062d\u0645\u064a\u0644 \u0635\u0648\u0631 \u0648\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a \u0644\u0645\u0646\u062a\u062c\u0643 \u0641\u064a \u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u0648\u0627\u0642\u0639\u064a\u0629."],"Match your branding":["\u0637\u0627\u0628\u0642 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629"],"Customize your emails, widgets, and showcases to match your brand.":["\u062e\u0635\u0635 \u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u060c \u0648\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0648\u0627\u062c\u0647\u0629\u060c \u0648\u0627\u0644\u0639\u0631\u0648\u0636 \u0644\u062a\u062a\u0646\u0627\u0633\u0628 \u0645\u0639 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629."],"Already use Reviewbird?":["\u0647\u0644 \u062a\u0633\u062a\u062e\u062f\u0645 Reviewbird \u0628\u0627\u0644\u0641\u0639\u0644\u061f"],"Sign in":["\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644"],"Loading Reviewbird\u2026":["\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 Reviewbird\u2026"],"(opens in a new tab)"