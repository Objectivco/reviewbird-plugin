{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_CN","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird":["Reviewbird"],"Reviewbird Settings":["Reviewbird \u8bbe\u7f6e"],"Connected to Reviewbird":["\u5df2\u8fde\u63a5\u5230 Reviewbird"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u60a8\u7684 WooCommerce \u5546\u5e97\u5df2\u6210\u529f\u8fde\u63a5\u5230 Reviewbird\u3002\u8bc4\u8bba\u6570\u636e\u6b63\u5728\u6b63\u5e38\u540c\u6b65\u3002"],"View Dashboard":["\u67e5\u770b\u4eea\u8868\u76d8"],"WooCommerce Not Connected":["WooCommerce \u672a\u8fde\u63a5"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u5c1a\u672a\u8fde\u63a5\u5230 Reviewbird\u3002\u8fde\u63a5\u60a8\u7684\u5546\u5e97\u4ee5\u5f00\u59cb\u540c\u6b65\u4ea7\u54c1\u548c\u8bc4\u8bba\u3002"],"Connect WooCommerce":["\u8fde\u63a5 WooCommerce"],"Initial Sync in Progress":["\u521d\u59cb\u540c\u6b65\u8fdb\u884c\u4e2d"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u6b63\u5728\u540c\u6b65\u60a8\u7684\u4ea7\u54c1\u548c\u8bc4\u8bba\u3002\u6839\u636e\u60a8\u7684\u76ee\u5f55\u5927\u5c0f\uff0c\u8fd9\u53ef\u80fd\u9700\u8981\u51e0\u5206\u949f\u3002\u540c\u6b65\u5b8c\u6210\u540e\u5c0f\u90e8\u4ef6\u5c06\u53ef\u7528\u3002"],"View Sync Progress":["\u67e5\u770b\u540c\u6b65\u8fdb\u5ea6"],"Subscription Required":["\u9700\u8981\u8ba2\u9605"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u60a8\u7684 Reviewbird \u8ba2\u9605\u5904\u4e8e\u975e\u6fc0\u6d3b\u72b6\u6001\u3002\u8bf7\u66f4\u65b0\u60a8\u7684\u8d26\u5355\u4fe1\u606f\u4ee5\u7ee7\u7eed\u4f7f\u7528\u670d\u52a1\u3002"],"Update Billing":["\u66f4\u65b0\u8d26\u5355"],"Connection Issue Detected":["\u68c0\u6d4b\u5230\u8fde\u63a5\u95ee\u9898"],"Unable to connect to Reviewbird. Please check your connection settings.":["\u65e0\u6cd5\u8fde\u63a5\u5230 Reviewbird\u3002\u8bf7\u68c0\u67e5\u60a8\u7684\u8fde\u63a5\u8bbe\u7f6e\u3002"],"Fix Connection":["\u4fee\u590d\u8fde\u63a5"],"Unable to reach Reviewbird API. Please check your internet connection.":["\u65e0\u6cd5\u8bbf\u95ee Reviewbird API\u3002\u8bf7\u68c0\u67e5\u60a8\u7684\u7f51\u7edc\u8fde\u63a5\u3002"],"Get Help":["\u83b7\u53d6\u5e2e\u52a9"],"Checking connection...":["\u6b63\u5728\u68c0\u67e5\u8fde\u63a5..."],"Verifying connection to Reviewbird...":["\u6b63\u5728\u9a8c\u8bc1\u4e0e Reviewbird \u7684\u8fde\u63a5..."],"Open Reviewbird":["\u6253\u5f00 Reviewbird"],"Connection Issue":["\u8fde\u63a5\u95ee\u9898"],"Refresh":["\u5237\u65b0"],"Last checked:":["\u4e0a\u6b21\u68c0\u67e5\u65f6\u95f4\uff1a"],"Failed to update setting. Please try again.":["\u66f4\u65b0\u8bbe\u7f6e\u5931\u8d25\u3002\u8bf7\u91cd\u8bd5\u3002"],"Connected Store Settings":["\u5df2\u8fde\u63a5\u5546\u5e97\u8bbe\u7f6e"],"Manage your Reviewbird integration with WooCommerce.":["\u7ba1\u7406\u60a8\u7684 Reviewbird \u4e0e WooCommerce \u7684\u96c6\u6210\u3002"],"Reviewbird Widget":["Reviewbird \u5c0f\u90e8\u4ef6"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u5728\u4ea7\u54c1\u9875\u9762\u663e\u793a Reviewbird \u8bc4\u4ef7\u5c0f\u90e8\u4ef6\u3002\u8be5\u5c0f\u90e8\u4ef6\u5c55\u793a\u5ba2\u6237\u8bc4\u4ef7\u5e76\u5141\u8bb8\u5ba2\u6237\u63d0\u4ea4\u65b0\u8bc4\u4ef7\u3002"],"Widget is enabled on all WooCommerce product pages.":["\u5c0f\u90e8\u4ef6\u5df2\u5728\u6240\u6709 WooCommerce \u4ea7\u54c1\u9875\u9762\u542f\u7528\u3002"],"Forcefully enable reviews on all products":["\u5f3a\u5236\u5728\u6240\u6709\u4ea7\u54c1\u4e0a\u542f\u7528\u8bc4\u4ef7"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u5982\u679c\u60a8\u5e0c\u671b\u901a\u8fc7\u201c\u542f\u7528\u8bc4\u4ef7\u201d\u590d\u9009\u6846\u5355\u72ec\u63a7\u5236\u6bcf\u4e2a\u4ea7\u54c1\u7684\u8bc4\u4ef7\uff0c\u8bf7\u5173\u95ed\u6b64\u9009\u9879\u3002"],"SEO Schema Markup":["SEO \u7ed3\u6784\u5316\u6570\u636e\u6807\u8bb0"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u5728\u4ea7\u54c1\u9875\u9762\u542f\u7528\u7b26\u5408 Google \u6807\u51c6\u7684\u7ed3\u6784\u5316\u6570\u636e\uff08JSON-LD schema\uff09\uff0c\u4ee5\u4fbf\u5728\u641c\u7d22\u7ed3\u679c\u4e2d\u663e\u793a\u4e30\u5bcc\u6458\u8981\u3002"],"Schema markup is active on all WooCommerce product pages.":["\u7ed3\u6784\u5316\u6570\u636e\u6807\u8bb0\u5df2\u5728\u6240\u6709 WooCommerce \u4ea7\u54c1\u9875\u9762\u6fc0\u6d3b\u3002"],"What is Schema Markup?":["\u4ec0\u4e48\u662f\u7ed3\u6784\u5316\u6570\u636e\u6807\u8bb0\uff1f"],"Displays star ratings in Google search results":["\u5728 Google \u641c\u7d22\u7ed3\u679c\u4e2d\u663e\u793a\u661f\u7ea7\u8bc4\u5206"],"Shows review counts and product information":["\u663e\u793a\u8bc4\u4ef7\u6570\u91cf\u548c\u4ea7\u54c1\u4fe1\u606f"],"Review schema is cached for 4 hours for optimal performance":["\u8bc4\u4ef7\u7ed3\u6784\u5316\u6570\u636e\u7f13\u5b58 4 \u5c0f\u65f6\u4ee5\u4f18\u5316\u6027\u80fd"],"Test with Google Rich Results":["\u4f7f\u7528 Google \u4e30\u5bcc\u7ed3\u679c\u6d4b\u8bd5"],"Validate Schema":["\u9a8c\u8bc1\u7ed3\u6784\u5316\u6570\u636e"],"Enabled":["\u5df2\u542f\u7528"],"Disabled":["\u5df2\u7981\u7528"],"Create your free account":["\u521b\u5efa\u60a8\u7684\u514d\u8d39\u8d26\u6237"],"takes about a minute":["\u5927\u7ea6\u9700\u8981\u4e00\u5206\u949f"],"Connect your WooCommerce site":["\u8fde\u63a5\u60a8\u7684 WooCommerce \u7f51\u7ad9"],"one secure click":["\u4e00\u6b21\u5b89\u5168\u70b9\u51fb"],"Turn on automatic review requests":["\u5f00\u542f\u81ea\u52a8\u8bc4\u4ef7\u8bf7\u6c42"],"you set the timing and content":["\u60a8\u8bbe\u7f6e\u65f6\u95f4\u548c\u5185\u5bb9"],"Already have an account?":["\u5df2\u7ecf\u6709\u8d26\u6237\uff1f"],"Sign in":["\u767b\u5f55"],"Getting started":["\u5165\u95e8\u6307\u5357"],"Turn your orders into powerful social proof.":["\u5c06\u60a8\u7684\u8ba2\u5355\u8f6c\u5316\u4e3a\u5f3a\u5927\u7684\u793e\u4ea4\u8bc1\u660e\u3002"],"You're three quick steps from your first five-star review!":["\u53ea\u9700\u4e09\u4e2a\u5feb\u901f\u6b65\u9aa4\uff0c\u83b7\u5f97\u60a8\u7684\u7b2c\u4e00\u6761\u4e94\u661f\u8bc4\u4ef7\uff01"],"Create free account":["\u521b\u5efa\u514d\u8d39\u8d26\u6237"],"Free plan details":["\u514d\u8d39\u8ba1\u5212\u8be6\u60c5"],"Free plan":["\u514d\u8d39\u8ba1\u5212"],"No credit card required":["\u65e0\u9700\u4fe1\u7528\u5361"],"25 review requests a month":["\u6bcf\u670825\u6b21\u8bc4\u4ef7\u8bf7\u6c42"],"Import your existing reviews":["\u5bfc\u5165\u60a8\u73b0\u6709\u7684\u8bc4\u4ef7"],"Send a bulk request to past customers":["\u5411\u8fc7\u53bb\u7684\u5ba2\u6237\u53d1\u9001\u6279\u91cf\u8bf7\u6c42"],"Built by the team behind CheckoutWC, trusted by <strong>8,000+ WooCommerce stores.<\/strong>":["\u7531 CheckoutWC \u56e2\u961f\u6253\u9020\uff0c<strong>8000+ WooCommerce \u5546\u5e97<\/strong>\u4fe1\u8d56\u3002"],"Example Reviewbird product review request email":["Reviewbird \u4ea7\u54c1\u8bc4\u4ef7\u8bf7\u6c42\u90ae\u4ef6\u793a\u4f8b"],"for Aster & Oak":["\u9002\u7528\u4e8e Aster & Oak"],"To: jamie@example.com":["\u6536\u4ef6\u4eba\uff1ajamie@example.com"],"Sent 3 days after delivery":["\u53d1\u8d27\u540e3\u5929\u53d1\u9001"],"How would you rate this product?":["\u60a8\u5982\u4f55\u8bc4\u4ef7\u8fd9\u6b3e\u4ea7\u54c1\uff1f"],"We would love it if you would share a bit about your experience.":["\u6211\u4eec\u5f88\u5e0c\u671b\u60a8\u80fd\u5206\u4eab\u4e00\u4e9b\u60a8\u7684\u4f7f\u7528\u4f53\u9a8c\u3002"],"Linen Throw Blanket \u2014 Sage":["\u4e9a\u9ebb\u6bef \u2014 \u9f20\u5c3e\u8349\u8272"],"Poor":["\u5dee"],"Great":["\u597d"],"You received this email because you made a purchase from Aster & Oak.":["\u60a8\u6536\u5230\u6b64\u90ae\u4ef6\u662f\u56e0\u4e3a\u60a8\u5728 Aster & Oak \u8d2d\u4e70\u4e86\u5546\u54c1\u3002"],"Unsubscribe from review emails":["\u53d6\u6d88\u8ba2\u9605\u8bc4\u4ef7\u90ae\u4ef6"]}}}