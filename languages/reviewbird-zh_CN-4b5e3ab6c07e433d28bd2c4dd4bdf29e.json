{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_CN","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["Reviewbird \u8bbe\u7f6e"],"Connected to Reviewbird":["\u5df2\u8fde\u63a5\u5230 Reviewbird"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u60a8\u7684 WooCommerce \u5546\u5e97\u5df2\u6210\u529f\u8fde\u63a5\u5230 Reviewbird\u3002\u8bc4\u8bba\u6570\u636e\u6b63\u5728\u6b63\u5e38\u540c\u6b65\u3002"],"View Dashboard":["\u67e5\u770b\u4eea\u8868\u76d8"],"WooCommerce Not Connected":["WooCommerce \u672a\u8fde\u63a5"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u5c1a\u672a\u8fde\u63a5\u5230 Reviewbird\u3002\u8fde\u63a5\u60a8\u7684\u5546\u5e97\u4ee5\u5f00\u59cb\u540c\u6b65\u4ea7\u54c1\u548c\u8bc4\u8bba\u3002"],"Connect WooCommerce":["\u8fde\u63a5 WooCommerce"],"Initial Sync in Progress":["\u521d\u59cb\u540c\u6b65\u8fdb\u884c\u4e2d"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u6b63\u5728\u540c\u6b65\u60a8\u7684\u4ea7\u54c1\u548c\u8bc4\u8bba\u3002\u6839\u636e\u60a8\u7684\u76ee\u5f55\u5927\u5c0f\uff0c\u8fd9\u53ef\u80fd\u9700\u8981\u51e0\u5206\u949f\u3002\u540c\u6b65\u5b8c\u6210\u540e\u5c0f\u90e8\u4ef6\u5c06\u53ef\u7528\u3002"],"View Sync Progress":["\u67e5\u770b\u540c\u6b65\u8fdb\u5ea6"],"Subscription Required":["\u9700\u8981\u8ba2\u9605"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u60a8\u7684 Reviewbird \u8ba2\u9605\u5904\u4e8e\u975e\u6fc0\u6d3b\u72b6\u6001\u3002\u8bf7\u66f4\u65b0\u60a8\u7684\u8d26\u5355\u4fe1\u606f\u4ee5\u7ee7\u7eed\u4f7f\u7528\u670d\u52a1\u3002"],"Update Billing":["\u66f4\u65b0\u8d26\u5355"],"Connection Issue Detected":["\u68c0\u6d4b\u5230\u8fde\u63a5\u95ee\u9898"],"Unable to connect to Reviewbird. Please check your connection settings.":["\u65e0\u6cd5\u8fde\u63a5\u5230 Reviewbird\u3002\u8bf7\u68c0\u67e5\u60a8\u7684\u8fde\u63a5\u8bbe\u7f6e\u3002"],"Fix Connection":["\u4fee\u590d\u8fde\u63a5"],"Unable to reach Reviewbird API. Please check your internet connection.":["\u65e0\u6cd5\u8bbf\u95ee Reviewbird API\u3002\u8bf7\u68c0\u67e5\u60a8\u7684\u7f51\u7edc\u8fde\u63a5\u3002"],"Get Help":["\u83b7\u53d6\u5e2e\u52a9"],"Checking connection...":["\u6b63\u5728\u68c0\u67e5\u8fde\u63a5..."],"Verifying connection to Reviewbird...":["\u6b63\u5728\u9a8c\u8bc1\u4e0e Reviewbird \u7684\u8fde\u63a5..."],"Open Reviewbird":["\u6253\u5f00 Reviewbird"],"Connection Issue (%s)":["\u8fde\u63a5\u95ee\u9898\uff08%s\uff09"],"Refresh":["\u5237\u65b0"],"Last checked: %s":["\u6700\u540e\u68c0\u67e5\u65f6\u95f4\uff1a%s"],"Failed to update setting. Please try again.":["\u66f4\u65b0\u8bbe\u7f6e\u5931\u8d25\u3002\u8bf7\u91cd\u8bd5\u3002"],"Connected Store Settings":["\u5df2\u8fde\u63a5\u5546\u5e97\u8bbe\u7f6e"],"Manage your Reviewbird integration with WooCommerce.":["\u7ba1\u7406\u60a8\u7684 Reviewbird \u4e0e WooCommerce \u7684\u96c6\u6210\u3002"],"Reviewbird Widget":["Reviewbird \u5c0f\u90e8\u4ef6"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u5728\u4ea7\u54c1\u9875\u9762\u663e\u793a Reviewbird \u8bc4\u4ef7\u5c0f\u90e8\u4ef6\u3002\u8be5\u5c0f\u90e8\u4ef6\u5c55\u793a\u5ba2\u6237\u8bc4\u4ef7\u5e76\u5141\u8bb8\u5ba2\u6237\u63d0\u4ea4\u65b0\u8bc4\u4ef7\u3002"],"Widget is enabled on all WooCommerce product pages.":["\u5c0f\u90e8\u4ef6\u5df2\u5728\u6240\u6709 WooCommerce \u4ea7\u54c1\u9875\u9762\u542f\u7528\u3002"],"Forcefully enable reviews on all products":["\u5f3a\u5236\u5728\u6240\u6709\u4ea7\u54c1\u4e0a\u542f\u7528\u8bc4\u4ef7"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u5982\u679c\u60a8\u5e0c\u671b\u901a\u8fc7\u201c\u542f\u7528\u8bc4\u4ef7\u201d\u590d\u9009\u6846\u5355\u72ec\u63a7\u5236\u6bcf\u4e2a\u4ea7\u54c1\u7684\u8bc4\u4ef7\uff0c\u8bf7\u5173\u95ed\u6b64\u9009\u9879\u3002"],"SEO Schema Markup":["SEO \u7ed3\u6784\u5316\u6570\u636e\u6807\u8bb0"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u5728\u4ea7\u54c1\u9875\u9762\u542f\u7528\u7b26\u5408 Google \u6807\u51c6\u7684\u7ed3\u6784\u5316\u6570\u636e\uff08JSON-LD schema\uff09\uff0c\u4ee5\u4fbf\u5728\u641c\u7d22\u7ed3\u679c\u4e2d\u663e\u793a\u4e30\u5bcc\u6458\u8981\u3002"],"Schema markup is active on all WooCommerce product pages.":["\u7ed3\u6784\u5316\u6570\u636e\u6807\u8bb0\u5df2\u5728\u6240\u6709 WooCommerce \u4ea7\u54c1\u9875\u9762\u6fc0\u6d3b\u3002"],"What is Schema Markup?":["\u4ec0\u4e48\u662f\u7ed3\u6784\u5316\u6570\u636e\u6807\u8bb0\uff1f"],"Displays star ratings in Google search results":["\u5728 Google \u641c\u7d22\u7ed3\u679c\u4e2d\u663e\u793a\u661f\u7ea7\u8bc4\u5206"],"Shows review counts and product information":["\u663e\u793a\u8bc4\u4ef7\u6570\u91cf\u548c\u4ea7\u54c1\u4fe1\u606f"],"Review schema is cached for 4 hours for optimal performance":["\u8bc4\u4ef7\u7ed3\u6784\u5316\u6570\u636e\u7f13\u5b58 4 \u5c0f\u65f6\u4ee5\u4f18\u5316\u6027\u80fd"],"Test with Google Rich Results":["\u4f7f\u7528 Google \u4e30\u5bcc\u7ed3\u679c\u6d4b\u8bd5"],"Validate Schema":["\u9a8c\u8bc1\u7ed3\u6784\u5316\u6570\u636e"],"Enabled":["\u5df2\u542f\u7528"],"Disabled":["\u5df2\u7981\u7528"],"The plugin is installed!":["\u63d2\u4ef6\u5df2\u5b89\u88c5\uff01"],"Your store is connected to Reviewbird":["\u60a8\u7684\u5546\u5e97\u5df2\u8fde\u63a5\u5230 Reviewbird"],"Now let's connect Reviewbird to your WooCommerce store.":["\u73b0\u5728\u8ba9\u6211\u4eec\u5c06 Reviewbird \u8fde\u63a5\u5230\u60a8\u7684 WooCommerce \u5546\u5e97\u3002"],"Continue in Reviewbird to customize your widget and review request emails.":["\u7ee7\u7eed\u5728 Reviewbird \u4e2d\u81ea\u5b9a\u4e49\u60a8\u7684\u5c0f\u90e8\u4ef6\u548c\u8bc4\u4ef7\u8bf7\u6c42\u90ae\u4ef6\u3002"],"Continue setup":["\u7ee7\u7eed\u8bbe\u7f6e"],"Your store is connected":["\u60a8\u7684\u5546\u5e97\u5df2\u8fde\u63a5"],"Manage your reviews, widgets, showcases and other settings in the dashboard.":["\u5728\u4eea\u8868\u677f\u4e2d\u7ba1\u7406\u60a8\u7684\u8bc4\u4ef7\u3001\u5c0f\u90e8\u4ef6\u3001\u5c55\u793a\u548c\u5176\u4ed6\u8bbe\u7f6e\u3002"],"Open dashboard":["\u6253\u5f00\u4eea\u8868\u677f"],"Bring your reviews with you":["\u968f\u8eab\u643a\u5e26\u60a8\u7684\u8bc4\u4ef7"],"Import from WooCommerce, Judge.me, Yotpo, and many more.":["\u4ece WooCommerce\u3001Judge.me\u3001Yotpo \u53ca\u66f4\u591a\u5e73\u53f0\u5bfc\u5165\u3002"],"Photo and video reviews":["\u7167\u7247\u548c\u89c6\u9891\u8bc4\u4ef7"],"Allow customers to upload photos and videos of your product in real life.":["\u5141\u8bb8\u5ba2\u6237\u4e0a\u4f20\u4ea7\u54c1\u7684\u771f\u5b9e\u7167\u7247\u548c\u89c6\u9891\u3002"],"Match your branding":["\u5339\u914d\u60a8\u7684\u54c1\u724c"],"Customize your emails, widgets, and showcases to match your brand.":["\u81ea\u5b9a\u4e49\u60a8\u7684\u90ae\u4ef6\u3001\u5c0f\u90e8\u4ef6\u548c\u5c55\u793a\u4ee5\u5339\u914d\u60a8\u7684\u54c1\u724c\u3002"],"Already use Reviewbird?":["\u5df2\u7ecf\u4f7f\u7528 Reviewbird\uff1f"],"Sign in":["\u767b\u5f55"],"Loading Reviewbird\u2026":["\u6b63\u5728\u52a0\u8f7d Reviewbird\u2026"],"(opens in a new tab)":["\uff08\u5728\u65b0\u6807\u7b7e\u9875\u6253\u5f00\uff09"],"Plugin settings":["\u63d2\u4ef6\u8bbe\u7f6e"],"Let's turn your WooCommerce product reviews up to 11.":["\u8ba9\u60a8\u7684 WooCommerce \u4ea7\u54c1\u8bc4\u4ef7\u63d0\u5347\u5230\u6781\u81f4\u3002"],"Automated review requests help you collect reviews automatically after each order. No busywork, just reliable review collection on autopilot.":["\u81ea\u52a8\u8bc4\u4ef7\u8bf7\u6c42\u5e2e\u52a9\u60a8\u5728\u6bcf\u7b14\u8ba2\u5355\u540e\u81ea\u52a8\u6536\u96c6\u8bc4\u4ef7\u3002\u65e0\u9700\u7e41\u7410\u64cd\u4f5c\uff0c\u53ea\u9700\u81ea\u52a8\u53ef\u9760\u5730\u6536\u96c6\u8bc4\u4ef7\u3002"],"Get started free":["\u514d\u8d39\u5f00\u59cb"],"Example Reviewbird product review request email":["Reviewbird \u4ea7\u54c1\u8bc4\u4ef7\u8bf7\u6c42\u90ae\u4ef6\u793a\u4f8b"],"Reviewbird <store>for Aster & Oak<\/store>":["Reviewbird <store>\u9002\u7528\u4e8e Aster & Oak<\/store>"],"To: jamie@example.com":["\u6536\u4ef6\u4eba\uff1ajamie@example.com"],"Review request":["\u8bc4\u4ef7\u8bf7\u6c42"],"How is your new blanket?":["\u60a8\u7684\u65b0\u6bef\u5b50\u600e\u4e48\u6837\uff1f"],"Share your experience to help other shoppers choose.":["\u5206\u4eab\u60a8\u7684\u4f53\u9a8c\uff0c\u5e2e\u52a9\u5176\u4ed6\u8d2d\u7269\u8005\u505a\u51fa\u9009\u62e9\u3002"],"Linen Throw Blanket, Sage":["\u4e9a\u9ebb\u6295\u63b7\u6bef\uff0c\u9f20\u5c3e\u8349\u8272"],"Poor":["\u5dee"],"Great":["\u597d"],"You received this review request after your purchase from Aster & Oak.":["\u60a8\u5728\u4ece Aster & Oak \u8d2d\u4e70\u540e\u6536\u5230\u4e86\u6b64\u8bc4\u4ef7\u8bf7\u6c42\u3002"],"Unsubscribe from review emails":["\u53d6\u6d88\u8ba2\u9605\u8bc4\u4ef7\u90ae\u4ef6"]}}}