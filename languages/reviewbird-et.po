#: assets/src/js/components/ConnectionHealth.jsx:10
msgid "Connected to Reviewbird"
msgstr "Ühendatud Reviewbirdiga"

#: assets/src/js/components/ConnectionHealth.jsx:11
msgid "Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly."
msgstr "Teie WooCommerce pood on edukalt ühendatud Reviewbirdiga. Arvustuste andmed sünkroonitakse korralikult."

#: assets/src/js/components/ConnectionHealth.jsx:12
msgid "View Dashboard"
msgstr "Vaata armatuurlauda"

#: assets/src/js/components/ConnectionHealth.jsx:18
msgid "WooCommerce Not Connected"
msgstr "WooCommerce ei ole ühendatud"

#: assets/src/js/components/ConnectionHealth.jsx:19
msgid "WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews."
msgstr "WooCommerce ei ole veel ühendatud Reviewbirdiga. Ühendage oma pood, et alustada toodete ja arvustuste sünkroonimist."

#: assets/src/js/components/ConnectionHealth.jsx:20
msgid "Connect WooCommerce"
msgstr "Ühenda WooCommerce"

#: assets/src/js/components/ConnectionHealth.jsx:26
msgid "Initial Sync in Progress"
msgstr "Esialgne sünkroonimine käib"

#: assets/src/js/components/ConnectionHealth.jsx:27
msgid "Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes."
msgstr "Reviewbird sünkroonib teie tooteid ja arvustusi. See võib võtta paar minutit, sõltuvalt teie kataloogi suurusest. Vidin on saadaval pärast sünkroonimise lõppu."

#: assets/src/js/components/ConnectionHealth.jsx:28
msgid "View Sync Progress"
msgstr "Vaata sünkroonimise edenemist"

#: assets/src/js/components/ConnectionHealth.jsx:34
msgid "Subscription Required"
msgstr "Tellimus vajalik"

#: assets/src/js/components/ConnectionHealth.jsx:35
msgid "Your Reviewbird subscription is inactive. Please update your billing information to continue using the service."
msgstr "Teie Reviewbirdi tellimus on inaktiivne. Palun uuendage oma arveldusteavet, et teenust jätkata."

#: assets/src/js/components/ConnectionHealth.jsx:36
msgid "Update Billing"
msgstr "Uuenda arveldust"

#: assets/src/js/components/ConnectionHealth.jsx:42
#: assets/src/js/components/ConnectionHealth.jsx:50
msgid "Connection Issue Detected"
msgstr "Ühenduse probleem tuvastatud"

#: assets/src/js/components/ConnectionHealth.jsx:43
msgid "Unable to connect to Reviewbird. Please check your connection settings."
msgstr "Ühendamine Reviewbirdiga ebaõnnestus. Palun kontrollige oma ühenduse seadeid."

#: assets/src/js/components/ConnectionHealth.jsx:44
msgid "Fix Connection"
msgstr "Paranda ühendus"

#: assets/src/js/components/ConnectionHealth.jsx:51
msgid "Unable to reach Reviewbird API. Please check your internet connection."
msgstr "Reviewbirdi API-le ei saa ühendust. Palun kontrollige oma internetiühendust."

#: assets/src/js/components/ConnectionHealth.jsx:52
msgid "Get Help"
msgstr "Saada abi"

#: assets/src/js/components/ConnectionHealth.jsx:58
msgid "Checking connection..."
msgstr "Ühenduse kontrollimine..."

#: assets/src/js/components/ConnectionHealth.jsx:59
msgid "Verifying connection to Reviewbird..."
msgstr "Ühenduse kinnitamine Reviewbirdiga..."

#: assets/src/js/components/ConnectionHealth.jsx:60
msgid "Open Reviewbird"
msgstr "Ava Reviewbird"

#: assets/src/js/components/ConnectionHealth.jsx:191
msgid "Connection Issue"
msgstr "Ühenduse probleem"

#: assets/src/js/components/ConnectionHealth.jsx:260
msgid "Refresh"
msgstr "Värskenda"

#: assets/src/js/components/ConnectionHealth.jsx:281
msgid "Last checked:"
msgstr "Viimati kontrollitud:"

#: assets/src/js/components/LoadingSpinner.jsx:8
msgid "Loading..."
msgstr "Laadimine..."

#: assets/src/js/components/SettingsApp.jsx:44
msgid "Failed to update setting. Please try again."
msgstr "Seadistuse uuendamine ebaõnnestus. Palun proovige uuesti."

#: assets/src/js/components/SettingsApp.jsx:90
msgid "Connected Store Settings"
msgstr "Ühendatud poe seaded"

#: assets/src/js/components/SettingsApp.jsx:96
msgid "Manage your Reviewbird integration with WooCommerce."
msgstr "Haldage oma Reviewbirdi integratsiooni WooCommerce'iga."

#: assets/src/js/components/SettingsApp.jsx:113
msgid "Reviewbird Widget"
msgstr "Reviewbirdi vidin"

#: assets/src/js/components/SettingsApp.jsx:114
msgid "Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews."
msgstr "Kuvage Reviewbirdi arvustuste vidin tootepaanidel. Vidin näitab klientide arvustusi ja võimaldab klientidel esitada uusi arvustusi."

#: assets/src/js/components/SettingsApp.jsx:120
msgid "Widget is enabled on all WooCommerce product pages."
msgstr "Vidin on lubatud kõigil WooCommerce'i tootepaanidel."

#: assets/src/js/components/SettingsApp.jsx:129
msgid "Forcefully enable reviews on all products"
msgstr "Sundige arvustused lubama kõigil toodetel"

#: assets/src/js/components/SettingsApp.jsx:135
msgid "Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox."
msgstr "Jätke see välja lülitatuks, kui soovite arvustusi kontrollida toote kaupa, kasutades märkeruutu \"Luba arvustused\"."

#: assets/src/js/components/SettingsApp.jsx:171
msgid "SEO Schema Markup"
msgstr "SEO skeemi märgendus"

#: assets/src/js/components/SettingsApp.jsx:172
msgid "Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results."
msgstr "Lülitage tootepaanidel sisse Google'i nõuetele vastav struktureeritud andmete (JSON-LD skeemi) tugi rikkalike väljavõtete jaoks otsingutulemustes."

#: assets/src/js/components/SettingsApp.jsx:178
msgid "Schema markup is active on all WooCommerce product pages."
msgstr "Skeemi märgendus on aktiivne kõigil WooCommerce'i tootepaanidel."

#: assets/src/js/components/SettingsApp.jsx:183
msgid "What is Schema Markup?"
msgstr "Mis on skeemi märgendus?"

#: assets/src/js/components/SettingsApp.jsx:185
msgid "Displays star ratings in Google search results"
msgstr "Kuvab Google'i otsingutulemustes tärnihinnanguid"

#: assets/src/js/components/SettingsApp.jsx:189
msgid "Shows review counts and product information"
msgstr "Näitab arvustuste arvu ja tooteinfot"

#: assets/src/js/components/SettingsApp.jsx:193
msgid "Review schema is cached for 4 hours for optimal performance"
msgstr "Arvustuste skeem on optimaalsete jõudluse tagamiseks vahemällu salvestatud 4 tunniks"

#: assets/src/js/components/SettingsApp.jsx:202
msgid "Test with Google Rich Results"
msgstr "Testi Google Rich Results abil"

#: assets/src/js/components/SettingsApp.jsx:209
msgid "Validate Schema"
msgstr "Valideeri skeem"

#: assets/src/js/components/TogglePanel.jsx:114
msgid "Enabled"
msgstr "Lubatud"

#: assets/src/js/components/TogglePanel.jsx:115
msgid "Disabled"
msgstr "Keelatud"

#: assets/src/js/components/WelcomeScreen.jsx:6
msgid "Create your Reviewbird account"
msgstr "Loo oma Reviewbirdi konto"

#: assets/src/js/components/WelcomeScreen.jsx:7
msgid "Start with the free plan, then connect your WooCommerce store whenever you are ready."
msgstr "Alusta tasuta plaaniga ja ühenda oma WooCommerce'i pood, kui oled valmis."

#: assets/src/js/components/WelcomeScreen.jsx:14
msgid "Authorize your WooCommerce store"
msgstr "Autoriseeri oma WooCommerce'i pood"

#: assets/src/js/components/WelcomeScreen.jsx:15
msgid "Connect Reviewbird so it can securely sync products, orders, and review activity."
msgstr "Ühenda Reviewbird, et see saaks turvaliselt sünkroonida tooteid, tellimusi ja arvustuste tegevust."

#: assets/src/js/components/WelcomeScreen.jsx:22
msgid "Turn on your review experience"
msgstr "Lülita oma arvustuste kogemuse sisse"

#: assets/src/js/components/WelcomeScreen.jsx:23
msgid "Enable the widget in WordPress and start collecting polished, conversion-friendly product reviews."
msgstr "Luba vidin WordPressis ja alusta professionaalsete, konversioonisõbralike tootearvustuste kogumist."

#: assets/src/js/components/WelcomeScreen.jsx:53
msgid "Step"
msgstr "Samm"

#: assets/src/js/components/WelcomeScreen.jsx:82
msgid "Welcome to Reviewbird for WooCommerce"
msgstr "Tere tulemast Reviewbirdi WooCommerce'i jaoks"

#: assets/src/js/components/WelcomeScreen.jsx:93
msgid "Collect more reviews with less friction."
msgstr "Kogu rohkem arvustusi vähem takistustega."

#: assets/src/js/components/WelcomeScreen.jsx:100
msgid "Reviewbird helps WooCommerce merchants collect, moderate, and showcase product reviews with a polished experience that feels native to their storefront."
msgstr "Reviewbird aitab WooCommerce'i kaupmeestel koguda, modereerida ja esitleda tootearvustusi professionaalse kogemusega, mis tundub loomulik nende poe jaoks."

#: assets/src/js/components/WelcomeScreen.jsx:115
msgid "Get Started Free"
msgstr "Alusta tasuta"

#: assets/src/js/components/WelcomeScreen.jsx:122
msgid "Free plan available. Create your account first, then connect WooCommerce when you are ready."
msgstr "Tasuta plaan saadaval. Loo esmalt konto, seejärel ühenda WooCommerce, kui oled valmis."

#: assets/src/js/components/WelcomeScreen.jsx:129
msgid "Already have an account?"
msgstr "Kas sul on juba konto?"

#: assets/src/js/components/WelcomeScreen.jsx:136
msgid "Connect your store"
msgstr "Ühenda oma pood"

#: assets/src/js/components/WelcomeScreen.jsx:145
msgid "See It In Action"
msgstr "Vaata seda tegevuses"

#: assets/src/js/components/WelcomeScreen.jsx:148
msgid "A quick look at the Reviewbird widget"
msgstr "Kiire pilk Reviewbirdi vidinale"

#: assets/src/js/components/WelcomeScreen.jsx:154
msgid "Leaving a review shouldn't feel applying for a loan. Our widget makes review submission easy and painless."
msgstr "Arvustuse jätmine ei tohiks tunduda nagu laenutaotluse esitamine. Meie vidin teeb arvustuse esitamise lihtsaks ja valutuks."

#: assets/src/js/components/WelcomeScreen.jsx:165
msgid "Reviewbird onboarding video"
msgstr "Reviewbirdi sissejuhatav video"

#: assets/src/js/components/WelcomeScreen.jsx:182
msgid "Setup"
msgstr "Seadistamine"

#: assets/src/js/components/WelcomeScreen.jsx:185
msgid "Go live in three quick steps."
msgstr "Mine otseülekandesse kolme kiire sammuga."

#: assets/src/js/components/WelcomeScreen.jsx:188
msgid "Create your account, connect WooCommerce, then"
msgstr "Loo oma konto, ühenda WooCommerce ja seejärel"

#: assets/src/js/components/WelcomeScreen.jsx:196
msgid "enable the widget in settings"
msgstr "luba vidin seadetes"
