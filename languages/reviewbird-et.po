#. Plugin Name of the plugin
#. Author of the plugin
#: reviewbird-plugin.php src/Admin/Settings.php:114 src/Admin/Settings.php:115
msgid "Reviewbird"
msgstr "Reviewbird"

#. Plugin URI of the plugin
#: reviewbird-plugin.php
msgid "https://reviewbird.com"
msgstr "https://reviewbird.com"

#. Description of the plugin
#: reviewbird-plugin.php
msgid ""
"Automated review collection for WooCommerce that blocks spam, catches "
"complaints, and showcases your best feedback."
msgstr ""
"Automatiseeritud arvustuste kogumine WooCommerce jaoks, mis blokeerib "
"rämpsposti, tabab kaebusi ja esitleb teie parimat tagasisidet."

