{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_TW","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird":["Reviewbird"],"Reviewbird Settings":["Reviewbird \u8a2d\u5b9a"],"Connected to Reviewbird":["\u5df2\u9023\u63a5\u5230 Reviewbird"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u60a8\u7684 WooCommerce \u5546\u5e97\u5df2\u6210\u529f\u9023\u63a5\u5230 Reviewbird\u3002\u8a55\u8ad6\u8cc7\u6599\u540c\u6b65\u6b63\u5e38\u3002"],"View Dashboard":["\u67e5\u770b\u5100\u8868\u677f"],"WooCommerce Not Connected":["WooCommerce \u672a\u9023\u63a5"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u5c1a\u672a\u9023\u63a5\u5230 Reviewbird\u3002\u8acb\u9023\u63a5\u60a8\u7684\u5546\u5e97\u4ee5\u958b\u59cb\u540c\u6b65\u7522\u54c1\u548c\u8a55\u8ad6\u3002"],"Connect WooCommerce":["\u9023\u63a5 WooCommerce"],"Initial Sync in Progress":["\u521d\u59cb\u540c\u6b65\u9032\u884c\u4e2d"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u6b63\u5728\u540c\u6b65\u60a8\u7684\u7522\u54c1\u548c\u8a55\u8ad6\u3002\u6839\u64da\u60a8\u7684\u76ee\u9304\u5927\u5c0f\uff0c\u9019\u53ef\u80fd\u9700\u8981\u5e7e\u5206\u9418\u3002\u540c\u6b65\u5b8c\u6210\u5f8c\uff0c\u5143\u4ef6\u5c07\u53ef\u7528\u3002"],"View Sync Progress":["\u67e5\u770b\u540c\u6b65\u9032\u5ea6"],"Subscription Required":["\u9700\u8981\u8a02\u95b1"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u60a8\u7684 Reviewbird \u8a02\u95b1\u5df2\u505c\u7528\u3002\u8acb\u66f4\u65b0\u60a8\u7684\u5e33\u55ae\u8cc7\u8a0a\u4ee5\u7e7c\u7e8c\u4f7f\u7528\u670d\u52d9\u3002"],"Update Billing":["\u66f4\u65b0\u5e33\u55ae"],"Connection Issue Detected":["\u5075\u6e2c\u5230\u9023\u7dda\u554f\u984c"],"Unable to connect to Reviewbird. Please check your connection settings.":["\u7121\u6cd5\u9023\u63a5\u5230 Reviewbird\u3002\u8acb\u6aa2\u67e5\u60a8\u7684\u9023\u7dda\u8a2d\u5b9a\u3002"],"Fix Connection":["\u4fee\u5fa9\u9023\u7dda"],"Unable to reach Reviewbird API. Please check your internet connection.":["\u7121\u6cd5\u9023\u63a5\u5230 Reviewbird API\u3002\u8acb\u6aa2\u67e5\u60a8\u7684\u7db2\u8def\u9023\u7dda\u3002"],"Get Help":["\u53d6\u5f97\u5354\u52a9"],"Checking connection...":["\u6b63\u5728\u6aa2\u67e5\u9023\u7dda..."],"Verifying connection to Reviewbird...":["\u6b63\u5728\u9a57\u8b49\u8207 Reviewbird \u7684\u9023\u7dda..."],"Open Reviewbird":["\u958b\u555f Reviewbird"],"Connection Issue":["\u9023\u7dda\u554f\u984c"],"Refresh":["\u91cd\u65b0\u6574\u7406"],"Last checked:":["\u6700\u5f8c\u6aa2\u67e5\u6642\u9593\uff1a"],"Failed to update setting. Please try again.":["\u8a2d\u5b9a\u66f4\u65b0\u5931\u6557\u3002\u8acb\u518d\u8a66\u4e00\u6b21\u3002"],"Connected Store Settings":["\u5df2\u9023\u63a5\u5546\u5e97\u8a2d\u5b9a"],"Manage your Reviewbird integration with WooCommerce.":["\u7ba1\u7406\u60a8\u7684 Reviewbird \u8207 WooCommerce \u7684\u6574\u5408\u3002"],"Reviewbird Widget":["Reviewbird \u5c0f\u5de5\u5177"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u5728\u7522\u54c1\u9801\u9762\u986f\u793a Reviewbird \u8a55\u8ad6\u5c0f\u5de5\u5177\u3002\u8a72\u5c0f\u5de5\u5177\u986f\u793a\u5ba2\u6236\u8a55\u8ad6\u4e26\u5141\u8a31\u5ba2\u6236\u63d0\u4ea4\u65b0\u8a55\u8ad6\u3002"],"Widget is enabled on all WooCommerce product pages.":["\u5c0f\u5de5\u5177\u5df2\u5728\u6240\u6709 WooCommerce \u7522\u54c1\u9801\u9762\u555f\u7528\u3002"],"Forcefully enable reviews on all products":["\u5f37\u5236\u5728\u6240\u6709\u7522\u54c1\u4e0a\u555f\u7528\u8a55\u8ad6"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u5982\u679c\u60a8\u5e0c\u671b\u900f\u904e\u300c\u555f\u7528\u8a55\u8ad6\u300d\u6838\u53d6\u65b9\u584a\u4f86\u63a7\u5236\u6bcf\u500b\u7522\u54c1\u7684\u8a55\u8ad6\uff0c\u8acb\u4fdd\u6301\u95dc\u9589\u6b64\u9078\u9805\u3002"],"SEO Schema Markup":["SEO \u7d50\u69cb\u5316\u6a19\u8a18"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u5728\u7522\u54c1\u9801\u9762\u555f\u7528\u7b26\u5408 Google \u898f\u7bc4\u7684\u7d50\u69cb\u5316\u8cc7\u6599\uff08JSON-LD schema\uff09\uff0c\u4ee5\u4fbf\u5728\u641c\u5c0b\u7d50\u679c\u4e2d\u986f\u793a\u8c50\u5bcc\u6458\u8981\u3002"],"Schema markup is active on all WooCommerce product pages.":["\u7d50\u69cb\u5316\u6a19\u8a18\u5df2\u5728\u6240\u6709 WooCommerce \u7522\u54c1\u9801\u9762\u555f\u7528\u3002"],"What is Schema Markup?":["\u4ec0\u9ebc\u662f\u7d50\u69cb\u5316\u6a19\u8a18\uff1f"],"Displays star ratings in Google search results":["\u5728 Google \u641c\u5c0b\u7d50\u679c\u4e2d\u986f\u793a\u661f\u7d1a\u8a55\u5206"],"Shows review counts and product information":["\u986f\u793a\u8a55\u8ad6\u6578\u91cf\u548c\u7522\u54c1\u8cc7\u8a0a"],"Review schema is cached for 4 hours for optimal performance":["\u8a55\u8ad6\u7d50\u69cb\u5316\u6a19\u8a18\u6703\u5feb\u53d6 4 \u5c0f\u6642\u4ee5\u9054\u5230\u6700\u4f73\u6548\u80fd"],"Test with Google Rich Results":["\u4f7f\u7528 Google \u8c50\u5bcc\u7d50\u679c\u6e2c\u8a66"],"Validate Schema":["\u9a57\u8b49\u7d50\u69cb\u5316\u6a19\u8a18"],"Enabled":["\u5df2\u555f\u7528"],"Disabled":["\u5df2\u505c\u7528"],"Create your free account":["\u5efa\u7acb\u60a8\u7684\u514d\u8cbb\u5e33\u6236"],"takes about a minute":["\u5927\u7d04\u9700\u8981\u4e00\u5206\u9418"],"Connect your WooCommerce site":["\u9023\u63a5\u60a8\u7684 WooCommerce \u7db2\u7ad9"],"one secure click":["\u4e00\u9375\u5b89\u5168\u9023\u63a5"],"Turn on automatic review requests":["\u958b\u555f\u81ea\u52d5\u8a55\u8ad6\u8acb\u6c42"],"you set the timing and content":["\u60a8\u8a2d\u5b9a\u6642\u9593\u548c\u5167\u5bb9"],"Already have an account?":["\u5df2\u7d93\u6709\u5e33\u6236\u4e86\u55ce\uff1f"],"Sign in":["\u767b\u5165"],"Getting started":["\u958b\u59cb\u4f7f\u7528"],"Turn your orders into powerful social proof.":["\u5c07\u60a8\u7684\u8a02\u55ae\u8f49\u5316\u70ba\u5f37\u5927\u7684\u793e\u6703\u8a8d\u8b49\u3002"],"You're three quick steps from your first five-star review!":["\u53ea\u9700\u4e09\u500b\u5feb\u901f\u6b65\u9a5f\uff0c\u5373\u53ef\u7372\u5f97\u60a8\u7684\u7b2c\u4e00\u500b\u4e94\u661f\u597d\u8a55\uff01"],"Create free account":["\u5efa\u7acb\u514d\u8cbb\u5e33\u6236"],"Free plan details":["\u514d\u8cbb\u65b9\u6848\u8a73\u60c5"],"Free plan":["\u514d\u8cbb\u65b9\u6848"],"No credit card required":["\u7121\u9700\u4fe1\u7528\u5361"],"25 review requests a month":["\u6bcf\u6708 25 \u6b21\u8a55\u8ad6\u8acb\u6c42"],"Import your existing reviews":["\u532f\u5165\u60a8\u73fe\u6709\u7684\u8a55\u8ad6"],"Send a bulk request to past customers":["\u5411\u904e\u53bb\u7684\u9867\u5ba2\u767c\u9001\u6279\u91cf\u8acb\u6c42"],"Built by the team behind CheckoutWC, trusted by <strong>8,000+ WooCommerce stores.<\/strong>":["\u7531 CheckoutWC \u5718\u968a\u6253\u9020\uff0c\u7372\u5f97 <strong>8,000+ WooCommerce \u5546\u5e97<\/strong>\u7684\u4fe1\u8cf4\u3002"],"Example Reviewbird product review request email":["Reviewbird \u7522\u54c1\u8a55\u8ad6\u8acb\u6c42\u90f5\u4ef6\u7bc4\u4f8b"],"for Aster & Oak":["\u91dd\u5c0d Aster & Oak"],"To: jamie@example.com":["\u6536\u4ef6\u4eba\uff1ajamie@example.com"],"Sent 3 days after delivery":["\u65bc\u4ea4\u8ca8\u5f8c 3 \u5929\u767c\u9001"],"How would you rate this product?":["\u60a8\u6703\u5982\u4f55\u8a55\u50f9\u9019\u500b\u7522\u54c1\uff1f"],"We would love it if you would share a bit about your experience.":["\u6211\u5011\u5f88\u5e0c\u671b\u60a8\u80fd\u5206\u4eab\u4e00\u4e9b\u60a8\u7684\u4f7f\u7528\u9ad4\u9a57\u3002"],"Linen Throw Blanket \u2014 Sage":["\u4e9e\u9ebb\u6bef \u2014 \u9f20\u5c3e\u8349\u8272"],"Poor":["\u5dee"],"Great":["\u597d"],"You received this email because you made a purchase from Aster & Oak.":["\u60a8\u6536\u5230\u6b64\u90f5\u4ef6\u662f\u56e0\u70ba\u60a8\u66fe\u5728 Aster & Oak \u8cfc\u8cb7\u5546\u54c1\u3002"],"Unsubscribe from review emails":["\u53d6\u6d88\u8a02\u95b1\u8a55\u8ad6\u90f5\u4ef6"]}}}