{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_TW","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird Settings":["Reviewbird \u8a2d\u5b9a"],"Connected to Reviewbird":["\u5df2\u9023\u63a5\u5230 Reviewbird"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u60a8\u7684 WooCommerce \u5546\u5e97\u5df2\u6210\u529f\u9023\u63a5\u5230 Reviewbird\u3002\u8a55\u8ad6\u8cc7\u6599\u540c\u6b65\u6b63\u5e38\u3002"],"View Dashboard":["\u67e5\u770b\u5100\u8868\u677f"],"WooCommerce Not Connected":["WooCommerce \u672a\u9023\u63a5"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u5c1a\u672a\u9023\u63a5\u5230 Reviewbird\u3002\u8acb\u9023\u63a5\u60a8\u7684\u5546\u5e97\u4ee5\u958b\u59cb\u540c\u6b65\u7522\u54c1\u548c\u8a55\u8ad6\u3002"],"Connect WooCommerce":["\u9023\u63a5 WooCommerce"],"Initial Sync in Progress":["\u521d\u59cb\u540c\u6b65\u9032\u884c\u4e2d"],"Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes.":["Reviewbird \u6b63\u5728\u540c\u6b65\u60a8\u7684\u7522\u54c1\u548c\u8a55\u8ad6\u3002\u6839\u64da\u60a8\u7684\u76ee\u9304\u5927\u5c0f\uff0c\u9019\u53ef\u80fd\u9700\u8981\u5e7e\u5206\u9418\u3002\u540c\u6b65\u5b8c\u6210\u5f8c\uff0c\u5143\u4ef6\u5c07\u53ef\u7528\u3002"],"View Sync Progress":["\u67e5\u770b\u540c\u6b65\u9032\u5ea6"],"Subscription Required":["\u9700\u8981\u8a02\u95b1"],"Your Reviewbird subscription is inactive. Please update your billing information to continue using the service.":["\u60a8\u7684 Reviewbird \u8a02\u95b1\u5df2\u505c\u7528\u3002\u8acb\u66f4\u65b0\u60a8\u7684\u5e33\u55ae\u8cc7\u8a0a\u4ee5\u7e7c\u7e8c\u4f7f\u7528\u670d\u52d9\u3002"],"Update Billing":["\u66f4\u65b0\u5e33\u55ae"],"Connection Issue Detected":["\u5075\u6e2c\u5230\u9023\u7dda\u554f\u984c"],"Unable to connect to Reviewbird. Please check your connection settings.":["\u7121\u6cd5\u9023\u63a5\u5230 Reviewbird\u3002\u8acb\u6aa2\u67e5\u60a8\u7684\u9023\u7dda\u8a2d\u5b9a\u3002"],"Fix Connection":["\u4fee\u5fa9\u9023\u7dda"],"Unable to reach Reviewbird API. Please check your internet connection.":["\u7121\u6cd5\u9023\u63a5\u5230 Reviewbird API\u3002\u8acb\u6aa2\u67e5\u60a8\u7684\u7db2\u8def\u9023\u7dda\u3002"],"Get Help":["\u53d6\u5f97\u5354\u52a9"],"Checking connection...":["\u6b63\u5728\u6aa2\u67e5\u9023\u7dda..."],"Verifying connection to Reviewbird...":["\u6b63\u5728\u9a57\u8b49\u8207 Reviewbird \u7684\u9023\u7dda..."],"Open Reviewbird":["\u958b\u555f Reviewbird"],"Connection Issue":["\u9023\u7dda\u554f\u984c"],"Refresh":["\u91cd\u65b0\u6574\u7406"],"Last checked:":["\u6700\u5f8c\u6aa2\u67e5\u6642\u9593\uff1a"],"Failed to update setting. Please try again.":["\u8a2d\u5b9a\u66f4\u65b0\u5931\u6557\u3002\u8acb\u518d\u8a66\u4e00\u6b21\u3002"],"Connected Store Settings":["\u5df2\u9023\u63a5\u5546\u5e97\u8a2d\u5b9a"],"Manage your Reviewbird integration with WooCommerce.":["\u7ba1\u7406\u60a8\u7684 Reviewbird \u8207 WooCommerce \u7684\u6574\u5408\u3002"],"Reviewbird Widget":["Reviewbird \u5c0f\u5de5\u5177"],"Display Reviewbird review widget on product pages. The widget shows customer reviews and allows customers to submit new reviews.":["\u5728\u7522\u54c1\u9801\u9762\u986f\u793a Reviewbird \u8a55\u8ad6\u5c0f\u5de5\u5177\u3002\u8a72\u5c0f\u5de5\u5177\u986f\u793a\u5ba2\u6236\u8a55\u8ad6\u4e26\u5141\u8a31\u5ba2\u6236\u63d0\u4ea4\u65b0\u8a55\u8ad6\u3002"],"Widget is enabled on all WooCommerce product pages.":["\u5c0f\u5de5\u5177\u5df2\u5728\u6240\u6709 WooCommerce \u7522\u54c1\u9801\u9762\u555f\u7528\u3002"],"Forcefully enable reviews on all products":["\u5f37\u5236\u5728\u6240\u6709\u7522\u54c1\u4e0a\u555f\u7528\u8a55\u8ad6"],"Leave this off if you prefer to control reviews per product using the \"Enable reviews\" checkbox.":["\u5982\u679c\u60a8\u5e0c\u671b\u900f\u904e\u300c\u555f\u7528\u8a55\u8ad6\u300d\u6838\u53d6\u65b9\u584a\u4f86\u63a7\u5236\u6bcf\u500b\u7522\u54c1\u7684\u8a55\u8ad6\uff0c\u8acb\u4fdd\u6301\u95dc\u9589\u6b64\u9078\u9805\u3002"],"SEO Schema Markup":["SEO \u7d50\u69cb\u5316\u6a19\u8a18"],"Enable Google-compliant structured data (JSON-LD schema) on product pages for rich snippets in search results.":["\u5728\u7522\u54c1\u9801\u9762\u555f\u7528\u7b26\u5408 Google \u898f\u7bc4\u7684\u7d50\u69cb\u5316\u8cc7\u6599\uff08JSON-LD schema\uff09\uff0c\u4ee5\u4fbf\u5728\u641c\u5c0b\u7d50\u679c\u4e2d\u986f\u793a\u8c50\u5bcc\u6458\u8981\u3002"],"Schema markup is active on all WooCommerce product pages.":["\u7d50\u69cb\u5316\u6a19\u8a18\u5df2\u5728\u6240\u6709 WooCommerce \u7522\u54c1\u9801\u9762\u555f\u7528\u3002"],"What is Schema Markup?":["\u4ec0\u9ebc\u662f\u7d50\u69cb\u5316\u6a19\u8a18\uff1f"],"Displays star ratings in Google search results":["\u5728 Google \u641c\u5c0b\u7d50\u679c\u4e2d\u986f\u793a\u661f\u7d1a\u8a55\u5206"],"Shows review counts and product information":["\u986f\u793a\u8a55\u8ad6\u6578\u91cf\u548c\u7522\u54c1\u8cc7\u8a0a"],"Review schema is cached for 4 hours for optimal performance":["\u8a55\u8ad6\u7d50\u69cb\u5316\u6a19\u8a18\u6703\u5feb\u53d6 4 \u5c0f\u6642\u4ee5\u9054\u5230\u6700\u4f73\u6548\u80fd"],"Test with Google Rich Results":["\u4f7f\u7528 Google \u8c50\u5bcc\u7d50\u679c\u6e2c\u8a66"],"Validate Schema":["\u9a57\u8b49\u7d50\u69cb\u5316\u6a19\u8a18"],"Enabled":["\u5df2\u555f\u7528"],"Disabled":["\u5df2\u505c\u7528"],"Create your Reviewbird account":["\u5efa\u7acb\u60a8\u7684 Reviewbird \u5e33\u6236"],"Start with the free plan, then connect your WooCommerce store whenever you are ready.":["\u5f9e\u514d\u8cbb\u65b9\u6848\u958b\u59cb\uff0c\u96a8\u6642\u6e96\u5099\u597d\u6642\u518d\u9023\u63a5\u60a8\u7684 WooCommerce \u5546\u5e97\u3002"],"Authorize your WooCommerce store":["\u6388\u6b0a\u60a8\u7684 WooCommerce \u5546\u5e97"],"Connect Reviewbird so it can securely sync products, orders, and review activity.":["\u9023\u63a5 Reviewbird\uff0c\u4ee5\u5b89\u5168\u540c\u6b65\u7522\u54c1\u3001\u8a02\u55ae\u548c\u8a55\u8ad6\u6d3b\u52d5\u3002"],"Turn on your review experience":["\u555f\u7528\u60a8\u7684\u8a55\u8ad6\u9ad4\u9a57"],"Enable the widget in WordPress and start collecting polished, conversion-friendly product reviews.":["\u5728 WordPress \u4e2d\u555f\u7528\u5c0f\u5de5\u5177\uff0c\u958b\u59cb\u6536\u96c6\u7cbe\u7dfb\u4e14\u6709\u52a9\u8f49\u63db\u7684\u7522\u54c1\u8a55\u8ad6\u3002"],"Step":["\u6b65\u9a5f"],"Welcome to Reviewbird for WooCommerce":["\u6b61\u8fce\u4f7f\u7528 WooCommerce \u7684 Reviewbird"],"Collect more reviews with less friction.":["\u4ee5\u66f4\u5c11\u963b\u7919\u6536\u96c6\u66f4\u591a\u8a55\u8ad6\u3002"],"Reviewbird helps WooCommerce merchants collect, moderate, and showcase product reviews with a polished experience that feels native to their storefront.":["Reviewbird \u5e6b\u52a9 WooCommerce \u5546\u5bb6\u6536\u96c6\u3001\u5be9\u6838\u4e26\u5c55\u793a\u7522\u54c1\u8a55\u8ad6\uff0c\u63d0\u4f9b\u8207\u5176\u5546\u5e97\u539f\u751f\u9ad4\u9a57\u76f8\u7b26\u7684\u7cbe\u7dfb\u9ad4\u9a57\u3002"],"Get Started Free":["\u514d\u8cbb\u958b\u59cb\u4f7f\u7528"],"Free plan available. Create your account first, then connect WooCommerce when you are ready.":["\u63d0\u4f9b\u514d\u8cbb\u65b9\u6848\u3002\u8acb\u5148\u5efa\u7acb\u5e33\u6236\uff0c\u6e96\u5099\u597d\u6642\u518d\u9023\u63a5 WooCommerce\u3002"],"Already have an account?":["\u5df2\u7d93\u6709\u5e33\u6236\u4e86\u55ce\uff1f"],"Connect your store":["\u9023\u63a5\u60a8\u7684\u5546\u5e97"],"See It In Action":["\u89c0\u770b\u793a\u7bc4"],"A quick look at the Reviewbird widget":["\u5feb\u901f\u700f\u89bd Reviewbird \u5c0f\u5de5\u5177"],"Leaving a review shouldn't feel applying for a loan. Our widget makes review submission easy and painless.":["\u7559\u4e0b\u8a55\u8ad6\u4e0d\u61c9\u8a72\u50cf\u7533\u8acb\u8cb8\u6b3e\u4e00\u6a23\u56f0\u96e3\u3002\u6211\u5011\u7684\u5c0f\u5de5\u5177\u8b93\u63d0\u4ea4\u8a55\u8ad6\u8b8a\u5f97\u7c21\u55ae\u4e14\u7121\u75db\u3002"],"Reviewbird onboarding video":["Reviewbird \u65b0\u624b\u6559\u5b78\u5f71\u7247"],"Setup":["\u8a2d\u5b9a"],"Go live in three quick steps.":["\u4e09\u500b\u5feb\u901f\u6b65\u9a5f\u5373\u53ef\u4e0a\u7dda\u3002"],"Create your account, connect WooCommerce, then":["\u5efa\u7acb\u5e33\u6236\uff0c\u9023\u63a5 WooCommerce\uff0c\u7136\u5f8c"],"enable the widget in settings":["\u5728\u8a2d\u5b9a\u4e2d\u555f\u7528\u5c0f\u5de5\u5177"]}}}