#: src/Admin/Settings.php:101
msgid "Ok, you deserve it"
msgstr "حسنًا، أنت تستحق ذلك"

#: src/Admin/Settings.php:103
msgid "Nope, maybe later"
msgstr "لا، ربما لاحقًا"

#: src/Admin/Settings.php:105
msgid "I already did"
msgstr "لقد فعلت ذلك بالفعل"

