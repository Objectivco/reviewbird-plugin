#: assets/src/js/components/ConnectionHealth.jsx:10
msgid "Connected to Reviewbird"
msgstr "متصل بريفيوبيرد"

#: assets/src/js/components/ConnectionHealth.jsx:11
msgid "Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly."
msgstr "متجرك WooCommerce متصل بريفيوبيرد بنجاح. يتم مزامنة بيانات المراجعات بشكل صحيح."

#: assets/src/js/components/ConnectionHealth.jsx:12
msgid "View Dashboard"
msgstr "عرض لوحة التحكم"

#: assets/src/js/components/ConnectionHealth.jsx:18
msgid "WooCommerce Not Connected"
msgstr "WooCommerce غير متصل"

#: assets/src/js/components/ConnectionHealth.jsx:19
msgid "WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews."
msgstr "لم يتم توصيل WooCommerce بعد بريفيوبيرد. قم بتوصيل متجرك لبدء مزامنة المنتجات والمراجعات."

#: assets/src/js/components/ConnectionHealth.jsx:20
msgid "Connect WooCommerce"
msgstr "توصيل WooCommerce"

#: assets/src/js/components/ConnectionHealth.jsx:26
msgid "Initial Sync in Progress"
msgstr "المزامنة الأولية جارية"

#: assets/src/js/components/ConnectionHealth.jsx:27
msgid "Reviewbird is syncing your products and reviews. This may take a few minutes depending on your catalog size. The widget will be available once sync completes."
msgstr "ريفيوبيرد يقوم بمزامنة منتجاتك ومراجعاتك. قد يستغرق هذا بضع دقائق حسب حجم الكتالوج الخاص بك. سيكون الودجت متاحًا بمجرد اكتمال المزامنة."

#: assets/src/js/components/ConnectionHealth.jsx:28
msgid "View Sync Progress"
msgstr "عرض تقدم المزامنة"

#: assets/src/js/components/ConnectionHealth.jsx:34
msgid "Subscription Required"
msgstr "اشتراك مطلوب"

#: assets/src/js/components/ConnectionHealth.jsx:35
msgid "Your Reviewbird subscription is inactive. Please update your billing information to continue using the service."
msgstr "اشتراكك في ريفيوبيرد غير نشط. يرجى تحديث معلومات الفوترة الخاصة بك للاستمرار في استخدام الخدمة."

#: assets/src/js/components/ConnectionHealth.jsx:36
msgid "Update Billing"
msgstr "تحديث الفوترة"

#: assets/src/js/components/ConnectionHealth.jsx:42
#: assets/src/js/components/ConnectionHealth.jsx:50
msgid "Connection Issue Detected"
msgstr "تم اكتشاف مشكلة في الاتصال"

#: assets/src/js/components/ConnectionHealth.jsx:43
msgid "Unable to connect to Reviewbird. Please check your connection settings."
msgstr "غير قادر على الاتصال بريفيوبيرد. يرجى التحقق من إعدادات الاتصال الخاصة بك."

#: assets/src/js/components/ConnectionHealth.jsx:44
msgid "Fix Connection"
msgstr "إصلاح الاتصال"

#: assets/src/js/components/ConnectionHealth.jsx:51
msgid "Unable to reach Reviewbird API. Please check your internet connection."
msgstr "غير قادر على الوصول إلى API ريفيوبيرد. يرجى التحقق من اتصال الإنترنت الخاص بك."

#: assets/src/js/components/ConnectionHealth.jsx:52
msgid "Get Help"
msgstr "الحصول على المساعدة"

#: assets/src/js/components/ConnectionHealth.jsx:58
msgid "Checking connection..."
msgstr "جارٍ التحقق من الاتصال..."

#: assets/src/js/components/ConnectionHealth.jsx:59
msgid "Verifying connection to Reviewbird..."
msgstr "جارٍ التحقق من الاتصال بريفيوبيرد..."

#: assets/src/js/components/ConnectionHealth.jsx:60
msgid "Open Reviewbird"
msgstr "فتح ريفيوبيرد"

#: assets/src/js/components/ConnectionHealth.jsx:191
msgid "Connection Issue"
msgstr "مشكلة في الاتصال"

#: assets/src/js/components/ConnectionHealth.jsx:260
msgid "Refresh"
msgstr "تحديث"

#: assets/src/js/components/ConnectionHealth.jsx:281
msgid "Last checked:"
msgstr "آخر فحص:"

#: assets/src/js/components/LoadingSpinner.jsx:8
msgid "Loading..."
