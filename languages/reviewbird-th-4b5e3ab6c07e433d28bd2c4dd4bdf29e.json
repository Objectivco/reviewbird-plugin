{"translation-revision-date":"2026-04-16 00:00+0000","generator":"WP-CLI\/2.12.0","source":"assets\/build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"th","plural-forms":"nplurals=2; plural=(n != 1);"},"Reviewbird":["\u0e23\u0e35\u0e27\u0e34\u0e27\u0e40\u0e1a\u0e34\u0e23\u0e4c\u0e14"],"Reviewbird Settings":["\u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32 Reviewbird"],"Connected to Reviewbird":["\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e01\u0e31\u0e1a Reviewbird \u0e41\u0e25\u0e49\u0e27"],"Your WooCommerce store is successfully connected to Reviewbird. Review data is syncing properly.":["\u0e23\u0e49\u0e32\u0e19\u0e04\u0e49\u0e32 WooCommerce \u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e01\u0e31\u0e1a Reviewbird \u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08 \u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e23\u0e35\u0e27\u0e34\u0e27\u0e01\u0e33\u0e25\u0e31\u0e07\u0e0b\u0e34\u0e07\u0e04\u0e4c\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e16\u0e39\u0e01\u0e15\u0e49\u0e2d\u0e07"],"View Dashboard":["\u0e14\u0e39\u0e41\u0e14\u0e0a\u0e1a\u0e2d\u0e23\u0e4c\u0e14"],"WooCommerce Not Connected":["WooCommerce \u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d"],"WooCommerce is not yet connected to Reviewbird. Connect your store to start syncing products and reviews.":["WooCommerce \u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e44\u0e14\u0e49\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e01\u0e31\u0e1a Reviewbird \u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e23\u0e49\u0e32\u0e19\u0e04\u0e49\u0e32\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e23\u0e34\u0e48\u0e21\u0e0b\u0e34\u0e07\u0e04\u0e4c\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e41\u0e25\u0e30\u0e23\u0e35\u0e27\u0e34\u0e27"],"Connect WooCommerce":["\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d WooCommerce"],"Initial Sync in Progress":["\u0e01\u0e