#. Plugin URI of the plugin
#: reviewbird-plugin.php
msgid "https://reviewbird.com"
msgstr "https://reviewbird.com"

#. Description of the plugin
#: reviewbird-plugin.php
msgid ""
"Automated review collection for WooCommerce that blocks spam, catches "
"complaints, and showcases your best feedback."
msgstr ""
"Automatisert innsamling av anmeldelser for WooCommerce som blokkerer spam, "
"fanger klager og viser frem dine beste tilbakemeldinger."

